# ZoikoShield backend environment.
#
# Docker:   cp .env.example .env            (docker-compose auto-loads ./.env)
# Host:     cp .env.example backend/.env    (services load .env from backend/;
#           shield-core also falls back to ../.env)
# Frontend: see frontend/.env.example — Next.js reads its own env file.
#
# Conventions in this file:
#   KEY=value      needed for local development; the value shown works locally.
#   # KEY=value    optional. Leave it commented unless you need to change it:
#                  the value shown is the code's own default. Do NOT uncomment
#                  it as an empty "KEY=" — several services use `??` fallbacks,
#                  and an empty string overrides the default instead of falling
#                  back to it (e.g. an empty SUPPORTED_DATA_REGIONS disables
#                  every region; an empty ANCHOR_WITNESS_PUBLIC_KEYS crashes).
#   [PRODUCTION]   must be set to a real value before production. Several of
#                  these have insecure hard-coded development fallbacks.

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
# Set per process, never shared: each service identifies itself with it when
# issuing workload tokens, and refuses to issue one without it. docker-compose
# sets it per container. In host mode, start each service with its own, e.g.
#   SERVICE_NAME=shield-core npm run start:dev
# SERVICE_NAME=shield-core

# ─── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_USER=shield
POSTGRES_PASSWORD=shield
POSTGRES_DB=shield_core
# Host port. Change it (and DATABASE_URL below) if 5432 is already taken by a
# system postgres on your machine.
POSTGRES_PORT=5432
# Two roles (backend/prisma/access/access-policy.js):
#   MIGRATION_DATABASE_URL  schema owner: runs migrations and the access policy.
#   DATABASE_URL            a non-superuser service login, subject to tenant
#                           row-level security. Never the superuser: it bypasses
#                           row-level security, so isolation would not apply.
# `docker compose up shield-core-migrate` creates the local service logins
# (shield_core_svc, ...); host-mode services and seed scripts use shield_core_svc.
# Containers do not read these; docker-compose builds its own per-service URLs.
MIGRATION_DATABASE_URL=postgres://shield:shield@localhost:5432/shield_core
DATABASE_URL=postgres://shield_core_svc:shield@localhost:5432/shield_core
# Password of the local service logins (docker-compose only).
# SERVICE_DB_PASSWORD=shield
# Overrides the owner URL the compose migrate step uses (e.g. a managed database).
# DOCKER_MIGRATION_DATABASE_URL=
# Log every database checkout that carries no tenant scope, with its first
# statement, to find code paths that reach tenant tables unscoped.
# DB_SCOPE_DEBUG=true
# Only needed for `prisma migrate dev` / `migrate diff --from-migrations`.
# SHADOW_DATABASE_URL=postgres://shield:shield@localhost:5432/shield_shadow

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ─── Redpanda (Kafka-API-compatible event backbone) ─────────────────────────
REDPANDA_KAFKA_PORT=9092
REDPANDA_PROXY_PORT=8082
# shield-core/shield-ingest/shield-action: same local Redpanda instance.
KAFKA_BROKERS=localhost:9092
# Comma-separated for a multi-broker cluster: a:9092,b:9092
# TLS and SASL for a managed Kafka. SASL implies TLS, so KAFKA_SSL is only
# needed for TLS without SASL. Mechanism: plain, scram-sha-256, scram-sha-512
# or oauthbearer. Google's Managed Service for Apache Kafka uses oauthbearer
# and needs no username or password — it authenticates with the attached
# service account.
# KAFKA_SSL=false
# KAFKA_SASL_MECHANISM=
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# ─── MinIO (S3-compatible object storage) ───────────────────────────────────
MINIO_ROOT_USER=shield
MINIO_ROOT_PASSWORD=shield12345
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── OpenSearch (optional, `--profile search`) ──────────────────────────────
OPENSEARCH_PORT=9200

# ─── Service ports and addresses ────────────────────────────────────────────
SHIELD_CORE_PORT=3001
# SHIELD_INGEST_PORT=3002
# SHIELD_AI_PORT=3003
# SHIELD_ACTION_PORT=3004
# SHIELD_ANCHOR_PORT=3005
# shield-core's own listen port in host mode (docker-compose sets it).
# PORT=3001
# Where services reach each other in host mode. docker-compose overrides these
# with container hostnames, so they only matter outside docker.
# SHIELD_CORE_BASE_URL=http://localhost:3001
# SHIELD_INGEST_BASE_URL=http://localhost:3002
# SHIELD_AI_BASE_URL=http://localhost:3003
# SHIELD_ANCHOR_BASE_URL=http://localhost:3005
# shield-core also accepts SHIELD_INGEST_URL, which takes precedence over
# SHIELD_INGEST_BASE_URL when both are set.
# SHIELD_INGEST_URL=

# ─── Auth (identity-adapter) ────────────────────────────────────────────────
JWT_SECRET=changeme-generate-a-long-random-value
JWT_EXPIRES_IN=15m
JWT_ISSUER=zoikoshield
JWT_AUDIENCE=zoikoshield-api
IAM_POLICY_VERSION=iam-policy-1.0.0

# Passkeys / WebAuthn step-up. The RP ID must be the registrable domain the
# browser is on; the origin must match the page exactly. shield-core defaults
# to localhost / http://localhost:3000.
# [PRODUCTION] shield-action defaults WEBAUTHN_RP_ID to security.zoikoshield.corp,
# which differs from shield-core's default — set both explicitly.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:3000

# Company-configured enterprise federation. In production, each secretRef in
# an IdP record names an individually injected secret-manager-backed variable.
# The JSON map is a local-development convenience only. Generate a distinct
# 32+ byte transaction key.
SSO_PUBLIC_BASE_URL=http://localhost:3001
SSO_APP_BASE_URL=http://localhost:3000
SSO_ALLOWED_IDP_HOSTS=login.microsoftonline.com,accounts.google.com,oauth2.googleapis.com,www.googleapis.com
SSO_SECRET_REFS_JSON={}
SSO_TRANSACTION_ENCRYPTION_KEY=change-me-to-a-distinct-long-random-value

# Platform-managed ZoikoID OIDC configuration automatically attached to every
# newly onboarded tenant. The client secret is read from the env variable named
# by ZOIKOID_OIDC_CLIENT_SECRET_REF; it is never persisted in the database.
ZOIKOID_OIDC_ISSUER=https://id.zoiko.example
ZOIKOID_OIDC_AUTHORIZATION_ENDPOINT=https://id.zoiko.example/oauth2/authorize
ZOIKOID_OIDC_TOKEN_ENDPOINT=https://id.zoiko.example/oauth2/token
ZOIKOID_OIDC_JWKS_URI=https://id.zoiko.example/.well-known/jwks.json
ZOIKOID_OIDC_CLIENT_ID=
ZOIKOID_OIDC_CLIENT_SECRET_REF=ZOIKOID_OIDC_CLIENT_SECRET
ZOIKOID_OIDC_CLIENT_SECRET=
ZOIKOID_OIDC_SIGNING_ALGORITHM=RS256
ZOIKOID_REQUIRE_MFA=true

# Legal text shown at sign-up. Development placeholders are used when unset.
# [PRODUCTION] shield-core refuses to start in production unless both
# TERMS_OF_SERVICE_TEXT and ACCESS_DISCLOSURE_TEXT are set.
# TERMS_OF_SERVICE_TEXT=
# TERMS_OF_SERVICE_VERSION=1
# ACCESS_DISCLOSURE_TEXT=
# ACCESS_DISCLOSURE_VERSION=1

# ─── Email and web origins ──────────────────────────────────────────────────
# OTP delivery via Gmail SMTP. Leave unset to fall back to console logging.
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Public web origin used to build tenant-owner activation links.
APP_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ─── Workload identity (service-to-service tokens) ──────────────────────────
# Development-only shared workload-token signing material. Production must
# use WORKLOAD_IDENTITY_PRIVATE_KEY_PEM / WORKLOAD_IDENTITY_PUBLIC_KEY_PEM.
# Must be set here in the ROOT .env (docker-compose only auto-loads this
# file, not backend/.env) with the SAME value as backend/.env's copy - if
# left unset here, docker-compose silently falls back to its own separate
# default, so services running in docker vs. host mode sign/verify with
# different secrets depending on what happened to be exported in whichever
# shell last ran `docker compose up`.
WORKLOAD_IDENTITY_DEV_SECRET=replace-with-a-long-random-local-secret
# [PRODUCTION] Asymmetric workload-token keys. PEMs may be written on one line
# with literal \n separators; they are unescaped on load.
# WORKLOAD_IDENTITY_PRIVATE_KEY_PEM=
# WORKLOAD_IDENTITY_PUBLIC_KEY_PEM=
# [PRODUCTION] shield-core workload-token broker HMAC. Falls back to a
# hard-coded development value when unset.
# WORKLOAD_MTLS_SECRET=

# ─── Tenant onboarding ──────────────────────────────────────────────────────
# Comma-separated allowlists. Defaults shown are the code's built-in lists.
# SUPPORTED_DATA_REGIONS=us-east-1,us-west-2,eu-west-1,eu-central-1,ap-south-1
# RETENTION_POLICY_REFS=default,standard-365d,security-365d,legal-7y
# [PRODUCTION] One regional encryption key per supported residency region,
# named KMS_KEY_<REGION> with dashes as underscores. Onboarding into a region
# fails in production when its key is missing. Not read outside production.
# KMS_KEY_US_EAST_1=
# KMS_KEY_US_WEST_2=
# KMS_KEY_EU_WEST_1=
# KMS_KEY_EU_CENTRAL_1=
# KMS_KEY_AP_SOUTH_1=

# ─── Case management (shield-core) ──────────────────────────────────────────
# Alerts that reach this severity open a case automatically; anything below it
# stays in the alert queue for an operator to promote. Set ENABLED=false to
# require every case to be opened by hand.
# CASE_AUTO_PROMOTION_ENABLED=true
# CASE_AUTO_PROMOTION_MIN_SEVERITY=HIGH

# ─── Evidence storage (shield-core / shield-ingest) ─────────────────────────
# MinIO locally, same credentials as the minio service above.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=shield
S3_SECRET_KEY=shield12345
# Object Lock (WORM) can only be enabled when a bucket is created, so a
# lock-enabled bucket is a distinct name from any pre-existing one.
EVIDENCE_S3_BUCKET=zoiko-shield-evidence-worm

# Evidence collector signatures. Development generates a fresh Ed25519 key on
# every start unless this PEM supplies a fixed one; production signs with
# Google Cloud KMS and refuses to start without COLLECTOR_KMS_KEY_VERSION.
# COLLECTOR_SIGNING_PRIVATE_KEY_PEM=
# [PRODUCTION] required in production. A key VERSION resource name, because a
# key can have several and a signature must name the one that produced it:
#   projects/P/locations/L/keyRings/R/cryptoKeys/K/cryptoKeyVersions/V
# COLLECTOR_KMS_KEY_VERSION=

# ─── Google Cloud ───────────────────────────────────────────────────────────
# Project for the KMS and Cloud Storage clients. Credentials come from the
# ambient service account on Cloud Run/GKE; set GOOGLE_APPLICATION_CREDENTIALS
# to a key file only when running outside GCP.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=
# Evidence bucket. When this and GOOGLE_CLOUD_PROJECT are both set, evidence
# is stored in Cloud Storage; otherwise the S3 client is used, which is what
# talks to MinIO locally. Cloud Storage is NOT reached through its
# S3-compatible API: that API has no Object Lock, so evidence would be written
# with no immutability and nothing would look wrong.
# EVIDENCE_GCS_BUCKET=
# EVIDENCE_GCS_LOCATION=US
# [PRODUCTION] Wraps per-subject encryption keys, so cryptographic shredding
# puts a subject's data beyond our own reach. A crypto KEY name, not a version
# — symmetric encrypt/decrypt resolves the primary version itself, so rotation
# does not strand previously wrapped keys:
#   projects/P/locations/L/keyRings/R/cryptoKeys/K
# SUBJECT_KEY_KMS_KEY_NAME=

# ─── Privacy: subject keys and tenant deletion ──────────────────────────────
# Wraps per-subject encryption keys locally. With SUBJECT_KEY_KMS_KEY_NAME set
# (see the Google Cloud section above), keys are wrapped and unwrapped by Cloud
# KMS instead, which is what puts a shredded subject beyond our own reach.
SUBJECT_KEY_WRAPPING_SECRET=replace-with-a-third-long-random-local-secret
# SUBJECT_KEY_WRAPPING_KEY_REF=env:SUBJECT_KEY_WRAPPING_SECRET

# Fallback retention period used only when a tenant has no recorded
# TenantRetentionPolicy. It is a configuration placeholder, NOT a legal
# determination — Privacy/Legal must ratify the real schedule before
# production. Unset means deletion eligibility cannot be established and
# tenant purges refuse to run, which is the intended fail-closed posture.
TENANT_RETENTION_DEFAULT_DAYS=90
TENANT_RETENTION_DEFAULT_AUTHORITY=ZoikoShield platform default (pending Privacy/Legal ratification)

# ─── Commercial, exports and payments (shield-core) ─────────────────────────
# [PRODUCTION] Signs usage-metering records. Falls back to a hard-coded
# development key when unset.
# METERING_SECRET=
# Signs export download links. Unset means a random key per process start,
# so links stop working after a restart (and across replicas).
# EXPORT_DOWNLOAD_SIGNING_SECRET=
# [PRODUCTION] Verifies Stripe webhook signatures. Falls back to a demo value.
# STRIPE_WEBHOOK_SECRET=
# Public developer API is disabled unless exactly "true".
# PUBLIC_DEVELOPER_API_ENABLED=false

# ─── Ingestion (shield-ingest) ──────────────────────────────────────────────
# Webhook HMAC verification. WEBHOOK_HMAC_SECRETS is a JSON object of
# secrets keyed by connector ID. WEBHOOK_HMAC_SECRET is a single fallback
# secret for any connector not in that map — honoured outside production only.
# With neither set, inbound webhooks cannot be verified and are rejected.
# The frontend signs webhooks it forwards with its own WEBHOOK_HMAC_SECRET
# (frontend/.env.example); the two must hold the same value.
# WEBHOOK_HMAC_SECRETS={"<connector-id>":"<secret>"}
# WEBHOOK_HMAC_SECRET=

# Microsoft Entra connector
# One shared ZoikoShield-side Entra app registration, used with the
# client-credentials flow against each customer's directory after admin
# consent. ENTRA_CLIENT_SECRET is the vault-reference env var name the
# CredentialService resolves — leave unset to have the connector fail
# cleanly with ConnectorAuthenticationError instead of silently faking a token.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3002/v1/connectors/entra/callback
# Standard cron syntax; defaults to every 5 minutes if unset.
# ENTRA_POLL_INTERVAL_CRON=0 */5 * * * *
# Other connector credentials are resolved the same way: a connector's
# credential record names an environment variable, and CredentialService reads
# that variable. Add one line per configured connector secret.

# ─── AI providers (shield-ai) ───────────────────────────────────────────────
# Without a key — or when the provider call fails — shield-ai does NOT error:
# it returns a canned "safe offline" response. Set a key to get real model
# output.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# Accepted in place of GEMINI_API_KEY.
# VERTEX_AI_API_KEY=

# ─── Governed response actions (shield-action) ──────────────────────────────
DEV_SIMULATION_SIGNING_KEY=replace-with-a-different-long-random-local-secret
# Governed command signatures. Development generates a fresh P-256 key on every
# start unless this PEM supplies a fixed one, and refuses to run at all in
# production. Setting ACTION_COMMAND_KMS_KEY_VERSION uses the Cloud KMS signer
# in any environment, so staging can exercise real key custody first.
# ACTION_COMMAND_DEV_PRIVATE_KEY=
# ACTION_COMMAND_DEV_KEY_ID=
# [PRODUCTION] required in production. A key VERSION resource name:
#   projects/P/locations/L/keyRings/R/cryptoKeys/K/cryptoKeyVersions/V
# ACTION_COMMAND_KMS_KEY_VERSION=
# [PRODUCTION] Approval-quorum signing keys. Both fall back to hard-coded
# development values when unset.
# DUAL_CUSTODY_SECRET_KEY=
# TWO_MAN_SIGNING_KEY=

# ─── Evidence anchoring (shield-anchor) ─────────────────────────────────────
# Development generates a fresh checkpoint signing key on every start unless
# this PEM supplies a fixed one; production signs with Google Cloud KMS and
# refuses to start without ANCHOR_KMS_KEY_VERSION.
# ANCHOR_SIGNING_PRIVATE_KEY_PEM=
# [PRODUCTION] required in production. A key VERSION resource name:
#   projects/P/locations/L/keyRings/R/cryptoKeys/K/cryptoKeyVersions/V
# ANCHOR_KMS_KEY_VERSION=
# External witnesses that co-sign checkpoints: comma-separated URLs, plus a
# JSON object of trusted public keys keyed by witness ID. No witnesses when
# unset. Never set ANCHOR_WITNESS_PUBLIC_KEYS to an empty value — it must
# parse as JSON.
# ANCHOR_WITNESS_URLS=
# ANCHOR_WITNESS_PUBLIC_KEYS={}

# ─── Diagnostic scripts only (backend/scripts) ──────────────────────────────
# Read by test-live-docker-spine.ts, test-live-infrastructure-connectivity.ts
# and simulate-regional-standby-failover.ts. The services never read these.
# DB_HOST=localhost
# DB_PORT=5432
# POSTGRES_HOST=localhost
# REDIS_HOST=localhost
# REDIS_URL=redis://localhost:6379
# KAFKA_HOST=localhost
# KAFKA_PORT=9092
# MINIO_HOST=localhost
# S3_HOST=localhost
# S3_PORT=9000
# SHIELD_ANCHOR_URL=http://localhost:3005
# SMOKE_TEST_TENANT_ID=
# SMOKE_TEST_TENANT_REGION=
# SMOKE_TEST_ENVIRONMENT_ID=
