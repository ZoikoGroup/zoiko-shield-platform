# Copy to .env and adjust as needed. Used by docker-compose.yml.

# Postgres
POSTGRES_USER=shield
POSTGRES_PASSWORD=shield
POSTGRES_DB=shield_core
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Redpanda (Kafka-API-compatible event backbone)
REDPANDA_KAFKA_PORT=9092
REDPANDA_PROXY_PORT=8082

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=shield
MINIO_ROOT_PASSWORD=shield12345
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# OpenSearch (optional, `--profile search`)
OPENSEARCH_PORT=9200

# shield-core
SHIELD_CORE_PORT=3001

# Auth (identity-adapter)
JWT_SECRET=changeme-generate-a-long-random-value
JWT_EXPIRES_IN=15m

# OAuth (optional - leave unset to disable Google/Microsoft login; app boots fine without them)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost:3001/auth/microsoft/callback
