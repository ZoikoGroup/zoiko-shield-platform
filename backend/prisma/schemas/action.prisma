// PostgreSQL schema "action". shield-action service: signed action commands, receipts and reconciliation.

// --- shield-action-owned ---
model ActionCommand {
  id                      String   @id @default(uuid())
  tenant_id               String
  environment_id          String
  proposal_id             String
  action_type             String
  target                  String   @default("{}")
  authority_level         String   @default("R1")
  approval_refs           String   @default("[]")
  policy_version          String   @default("1.0")
  nonce                   String   @unique
  expires_at              DateTime
  rate_class              String   @default("DEFAULT")
  expected_receipt_schema String?
  signature               String?
  correlation_id          String
  created_at              DateTime @default(now())

  receipts ActionReceipt[]

  @@index([tenant_id])
  @@index([proposal_id])

  @@schema("action")
}

model ActionReceipt {
  id                  String        @id @default(uuid())
  tenant_id           String
  action_command_id   String
  actionCommand       ActionCommand @relation(fields: [action_command_id], references: [id])
  provider            String        @default("SIMULATION")
  provider_receipt_id String?
  status              String // ACCEPTED | EXECUTED | VERIFIED | FAILED | PARTIALLY_EXECUTED | UNKNOWN | SIMULATED
  accepted_at         DateTime?
  executed_at         DateTime?
  verified_at         DateTime?
  observed_state      String        @default("{}")
  error_code          String?
  signature_verified  Boolean?
  correlation_id      String
  created_at          DateTime      @default(now())

  reconciliations ActionReconciliation[]

  @@index([tenant_id])
  @@index([action_command_id])

  @@schema("action")
}

model ActionReconciliation {
  id                String         @id @default(uuid())
  tenant_id         String
  action_command_id String
  action_receipt_id String?
  actionReceipt     ActionReceipt? @relation(fields: [action_receipt_id], references: [id])
  expected_state    String         @default("{}")
  observed_state    String         @default("{}")
  result            String // VERIFIED | FAILED | UNKNOWN
  checked_at        DateTime       @default(now())
  evidence_ref      String?

  @@index([tenant_id])
  @@index([action_command_id])

  @@schema("action")
}

model ActionRateLimit {
  id           String @id @default(uuid())
  tenant_id    String
  action_type  String
  target_class String @default("DEFAULT")
  window       String @default("1h")
  maximum      Int    @default(10)

  @@unique([tenant_id, action_type, target_class, window])

  @@schema("action")
}

// Durable containment-escalation workflow state, persisted to Postgres so it
// survives process restarts and is resumable from a fresh instance — see
// DurableContainmentEscalationService, which replaced an in-memory Map that
// falsely branded itself "Temporal" while providing none of Temporal's
// durability guarantees.
model DurableWorkflowInstance {
  id                     String    @id @default(uuid())
  tenant_id              String
  workflow_id            String    @unique
  workflow_type          String    @default("CONTAINMENT_ESCALATION")
  incident_ref           String
  target_resource        String
  action_type            String
  current_tier           String
  current_state          String
  mfa_challenge_verified Boolean   @default(false)
  action_receipt_id      String?
  rollback_receipt_id    String?
  attestation_digest     String
  started_at             DateTime  @default(now())
  completed_at           DateTime?
  updated_at             DateTime  @updatedAt

  transitions DurableWorkflowTransition[]

  @@index([tenant_id])

  @@schema("action")
}

model DurableWorkflowTransition {
  id                   String                  @id @default(uuid())
  workflow_instance_id String
  workflowInstance     DurableWorkflowInstance @relation(fields: [workflow_instance_id], references: [id])
  tenant_id            String
  state                String
  recorded_by          String?
  metadata_reference   String
  occurred_at          DateTime                @default(now())

  @@index([workflow_instance_id])
  @@index([tenant_id])

  @@schema("action")
}
