// Authorization plane: roles, permissions, memberships, invitations and JIT
// elevation. Owned by the authorization module. Memberships are read to
// establish a request's tenant, so this schema is platform-global and
// protected by the service role grants rather than tenant row-level security.

model Invitation {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash          String    @unique @db.VarChar
  tenantId           String    @db.Uuid
  invitedEmail       String    @db.VarChar
  roleId             String    @db.Uuid
  invitedById        String    @db.Uuid
  status             String    @default("PENDING") @db.VarChar
  expiresAt          DateTime  @db.Timestamptz(6)
  acceptedAt         DateTime? @db.Timestamptz(6)
  acceptedById       String?   @db.Uuid
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  purpose            String    @default("TENANT_MEMBERSHIP") @db.VarChar
  invitedPrincipalId String?   @db.Uuid
  policyDocumentId   String?   @db.Uuid

  @@index([tenantId], map: "idx_invitations_tenant")
  @@index([tenantId, invitedPrincipalId, status], map: "invitations_owner_activation_lookup", where: raw("((purpose)::text = 'OWNER_ACTIVATION'::text)"))
  @@map("invitations")
  @@schema("authorization")
}

model JitElevationRequest {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  superAdminPrincipalId      String    @db.Uuid
  targetTenantId             String    @db.Uuid
  statedPurpose              String
  requestedDurationMinutes   Int       @default(60)
  roleCode                   String    @default("TENANT_SECURITY_ANALYST") @db.VarChar
  status                     String    @default("PENDING") @db.VarChar
  approvedByPrincipalId      String?   @db.Uuid
  rejectionReason            String?
  approvedAt                 DateTime? @db.Timestamptz(6)
  expiresAt                  DateTime? @db.Timestamptz(6)
  membershipId               String?   @db.Uuid
  customerVisibleAuditLogRef String    @db.VarChar(64)
  createdAt                  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([superAdminPrincipalId, targetTenantId], map: "jit_elevation_requests_admin_tenant_idx")
  @@index([targetTenantId, status], map: "jit_elevation_requests_tenant_status_idx")
  @@map("jit_elevation_requests")
  @@schema("authorization")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique @db.VarChar(150)
  description String?
  roles       RolePermission[]

  @@map("permissions")
  @@schema("authorization")
}

model RolePermission {
  role_id       String     @db.Uuid
  permission_id String     @db.Uuid
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_id])
  @@map("role_permissions")
  @@schema("authorization")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Null for platform-level roles; set for tenant-scoped custom roles.
  tenantId    String?          @db.Uuid
  code        String           @db.VarChar(100)
  name        String           @db.VarChar(255)
  roleLevel   String           @db.VarChar
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  permissions RolePermission[]
  memberships UserRole[]

  @@map("roles")
  @@schema("authorization")
}

model TenantMembership {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String     @db.Uuid
  principalId         String     @db.Uuid
  status              String     @default("ACTIVE") @db.VarChar
  /// INVITATION | SCIM | BOOTSTRAP | JIT_ELEVATION: how the membership was established.
  source              String     @default("INVITATION") @db.VarChar
  joinedAt            DateTime   @default(now()) @db.Timestamptz(6)
  expiresAt           DateTime?  @db.Timestamptz(6)
  elevationPurpose    String?    @db.VarChar
  elevationApprovedBy String?    @db.Uuid
  roles               UserRole[]

  @@unique([tenantId, principalId])
  @@map("tenant_memberships")
  @@schema("authorization")
}

model UserRole {
  membership_id String           @db.Uuid
  role_id       String           @db.Uuid
  membership    TenantMembership @relation(fields: [membership_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role          Role             @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([membership_id, role_id])
  @@map("user_roles")
  @@schema("authorization")
}

/// W12 (Spec §619: "Draft/diff, scope, impact, approvers, test/simulation,
/// staged deployment, effective version, rollback and audit record"). Unlike
/// the rest of this file, this is tenant-owned configuration data rather than
/// identity/role plumbing, so it carries ordinary tenant row-level security
/// (prisma/access/access-policy.js: tenant_or_shared) instead of the
/// control_plane exemption the other tables in this schema use.
model ConfigPolicyVersion {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Null marks the shared canonical baseline every tenant starts from; a
  /// tenant's first lifecycle action on it forks a tenant-owned row.
  tenantId          String?   @db.Uuid
  /// Stable identity across versions/forks of the same policy, e.g.
  /// "zero-trust-jit-admin-escalation". Distinct from `version`.
  policyKey         String    @db.VarChar(150)
  policyName        String    @db.VarChar(255)
  domain            String    @db.VarChar(40)
  version           String    @db.VarChar(40)
  status            String    @default("PENDING_APPROVAL") @db.VarChar(40)
  stagedEnvironment String?   @db.VarChar(100)
  canaryPercentage  Int       @default(0)
  author            String    @db.VarChar(255)
  approvers         String[]  @default([])
  commitHash        String    @db.VarChar(64)
  diffSummary       String
  diffPrevious      String
  diffProposed      String
  reversalReason    String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  auditEvents ConfigPolicyAuditEvent[]

  @@unique([tenantId, policyKey])
  @@index([tenantId])
  @@map("config_policy_versions")
  @@schema("authorization")
}

/// The "audit record" W12 requires. Append-only: every stage/simulate/
/// approve/rollback call writes one row here and nothing updates or deletes
/// one afterward.
model ConfigPolicyAuditEvent {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String              @db.Uuid
  policyVersionId String              @db.Uuid
  policyVersion   ConfigPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  action          String              @db.VarChar(40)
  actorId         String              @db.VarChar(255)
  detail          String
  occurredAt      DateTime            @default(now()) @db.Timestamptz(6)

  @@index([tenantId])
  @@index([policyVersionId])
  @@map("config_policy_audit_events")
  @@schema("authorization")
}
