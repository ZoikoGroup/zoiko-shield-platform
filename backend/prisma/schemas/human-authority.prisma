// PostgreSQL schema "human_authority". human-authority module.

model AiHumanAuthorityDecision {
  id                    String         @id @default(uuid())
  tenant_id             String
  environment_id        String
  action_class          String
  resource_type         String
  resource_id           String
  actor_id              String
  decision_origin       String
  ai_output_id          String?
  aiOutput              AiOutput?      @relation(fields: [ai_output_id], references: [id], onDelete: Restrict)
  ai_human_review_id    String?
  aiHumanReview         AiHumanReview? @relation(fields: [ai_human_review_id], references: [id], onDelete: Restrict)
  human_confirmation    Boolean        @default(false)
  authority_statement   String
  decision              String
  reason                String
  authorization_context String         @default("{}")
  created_at            DateTime       @default(now())

  @@index([tenant_id, environment_id, created_at])
  @@index([action_class, resource_type, resource_id])
  @@index([actor_id, created_at])
  @@index([ai_output_id])

  @@schema("human_authority")
}
