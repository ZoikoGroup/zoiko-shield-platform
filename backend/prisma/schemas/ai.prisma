// PostgreSQL schema "ai". shield-ai service: AI use cases, model/prompt profiles, outputs, reviews and AI incidents.

// --- shield-ai-owned ---
model AiUseCase {
  id                    String    @id @default(uuid())
  key                   String    @unique
  name                  String
  description           String?
  risk_class            String    @default("STANDARD")
  allowed_data_classes  String    @default("[]")
  allowed_tools         String    @default("[]")
  human_review_required Boolean   @default(true)
  prohibited_actions    String    @default("[]")
  max_input_tokens      Int?
  max_output_tokens     Int?
  status                String    @default("ACTIVE")
  expires_at            DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@index([status])

  @@schema("ai")
}

model ModelProfile {
  id                    String   @id @default(uuid())
  provider              String
  model                 String
  model_version         String?
  region                String
  approved_data_classes String   @default("[]")
  retention_policy      String   @default("NONE")
  training_allowed      Boolean  @default(false)
  fallback_profile_id   String?
  evaluation_version    String   @default("1.0")
  status                String   @default("ACTIVE")
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@index([status])

  @@schema("ai")
}

model PromptProfile {
  id                    String    @id @default(uuid())
  key                   String
  version               Int
  system_prompt_ref     String
  output_schema         String    @default("{}")
  allowed_sources       String    @default("[]")
  safety_policy_version String    @default("1.0")
  status                String    @default("DRAFT")
  published_at          DateTime?
  created_at            DateTime  @default(now())

  @@unique([key, version])
  @@index([status])

  @@schema("ai")
}

model AiOutput {
  id                        String   @id @default(uuid())
  tenant_id                 String
  environment_id            String   @default("default-env")
  use_case_id               String
  model_profile_id          String
  prompt_profile_id         String
  retrieval_bundle_id       String?
  output_type               String
  content                   String
  citations                 String   @default("[]")
  limitations               String   @default("[]")
  safety_result             String   @default("PENDING")
  review_status             String   @default("UNREVIEWED")
  authorization_decision_id String
  correlation_id            String
  created_at                DateTime @default(now())

  humanReviews            AiHumanReview[]
  humanAuthorityDecisions AiHumanAuthorityDecision[]

  @@index([tenant_id])
  @@index([use_case_id])

  @@schema("ai")
}

model AiHumanReview {
  id               String   @id @default(uuid())
  tenant_id        String
  ai_output_id     String
  aiOutput         AiOutput @relation(fields: [ai_output_id], references: [id])
  reviewer_id      String
  decision         String
  rationale        String?
  modified_content String?
  reviewed_at      DateTime @default(now())

  humanAuthorityDecisions AiHumanAuthorityDecision[]

  @@index([tenant_id])
  @@index([ai_output_id])

  @@schema("ai")
}

model RetrievalBundle {
  id                     String   @id @default(uuid())
  tenant_id              String
  environment_id         String   @default("default-env")
  purpose                String
  case_id                String?
  source_refs            String   @default("[]")
  evidence_refs          String   @default("[]")
  source_versions        String   @default("{}")
  freshness_state        String   @default("CURRENT")
  completeness_state     String   @default("UNKNOWN")
  acl_snapshot           String   @default("{}")
  index_version          String?
  poisoning_check_result String?
  created_at             DateTime @default(now())

  @@index([tenant_id])
  @@index([case_id])

  @@schema("ai")
}

model AiToolCall {
  id                        String    @id @default(uuid())
  tenant_id                 String
  agent_run_id              String?
  tool_name                 String
  tool_version              String    @default("1.0")
  arguments_hash            String
  authorization_decision_id String
  idempotency_key           String?
  result_ref                String?
  status                    String    @default("PENDING")
  error_code                String?
  started_at                DateTime  @default(now())
  completed_at              DateTime?

  @@index([tenant_id])
  @@index([tool_name])

  @@schema("ai")
}

// ============================================================
// §23: AI Incident Lifecycle (shield-ai)
// Previously an in-memory Map on AiIncidentService - a process
// restart silently erased incident/RCA/decision history. This
// gives it the durability the audit trail already assumes.
// ============================================================

model AiIncident {
  id                   String    @id
  tenant_id            String
  title                String
  category             String
  severity             String
  status               String
  description          String
  affected_model       String?
  affected_prompt_key  String?
  affected_tool        String?
  kill_switch_active   Boolean   @default(false)
  kill_switch_details  String?
  fallback_active      Boolean   @default(false)
  fallback_details     String?
  rca_summary          String?
  rca_details          String?
  decision_envelope_id String?
  decision_envelope    String?
  resolution_summary   String?
  declared_at          DateTime
  resolved_at          DateTime?
  closed_at            DateTime?
  timeline             String    @default("[]")
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  @@index([tenant_id, status])
  @@index([tenant_id, severity])
  @@map("ai_incidents")

  @@schema("ai")
}

// ============================================================
// §16: AI Review Envelope / Decision Rights (shield-ai)
// Previously an in-memory Map on DecisionRightsService, so a
// restart erased the human-oversight record an @RequireAssurance-
// style downstream gate assumes still exists. DecisionRightsService
// keeps its in-memory Map as the synchronous source of truth (its
// wrapInEnvelope/getEnvelope/assertActionPermitted/listEnvelopes
// methods are called synchronously in ~10 places across services,
// scripts, and tests that construct it directly without DI) and
// write-throughs to this table for durability, rehydrating the map
// from here on module init.
// ============================================================

model AiReviewEnvelope {
  id            String   @id
  tenant_id     String
  envelope_json String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([tenant_id])
  @@map("ai_review_envelopes")

  @@schema("ai")
}
