// PostgreSQL schema "ai_governance". ai-governance module.

// ============================================================
// ZS-COM-BILL-001 P1 Part 12 / AI-01: internal AI cost != customer
// billable usage. Every AI action is logged with its true internal cost;
// it becomes customer-billable only through the same accepted-vs-billable
// MeteringService pipeline used everywhere else, gated on an explicit
// customer authorization (active AI_SECURITY entitlement).
// ============================================================

model AiUsageRecord {
  id                             String               @id @default(uuid())
  tenant_id                      String
  environment_id                 String               @default("UNBOUND")
  governance_profile_id          String?
  governanceProfile              AiGovernanceProfile? @relation(fields: [governance_profile_id], references: [id])
  use_case_key                   String               @default("LEGACY_UNBOUND")
  workflow                       String
  workflow_class                 String               @default("STANDARD")
  provider                       String
  model                          String
  model_profile_id               String?
  model_class                    String               @default("STANDARD")
  input_tokens                   Int                  @default(0)
  output_tokens                  Int                  @default(0)
  tool_calls                     Int                  @default(0)
  retrieval_calls                Int                  @default(0)
  retrieval_units                Int                  @default(0)
  ai_storage_byte_hours          Decimal              @default(0) @db.Decimal(20, 4)
  contracted_usage_units         Decimal              @default(0) @db.Decimal(14, 4)
  complexity_units               Decimal              @default(0) @db.Decimal(14, 4)
  internal_cost                  Decimal              @default(0) @db.Decimal(14, 6)
  internal_cost_source           String               @default("CALLER_REPORTED")
  provider_price_version         String?
  fallback_used                  Boolean              @default(false)
  fallback_from_model_profile_id String?
  billing_classification         String               @default("INTERNAL_COST_ONLY")
  billable                       Boolean              @default(false)
  billable_quantity              Decimal              @default(0) @db.Decimal(14, 4)
  meter_event_id                 String?
  catalog_version_id             String?
  customer_authorization_ref     String?
  occurred_at                    DateTime             @default(now())
  created_at                     DateTime             @default(now())

  @@index([tenant_id, environment_id, occurred_at])
  @@index([governance_profile_id, occurred_at])
  @@index([occurred_at])

  @@schema("ai_governance")
}

model AiGovernanceProfile {
  id                               String            @id @default(uuid())
  tenant_id                        String
  environment_id                   String
  commercial_account_id            String
  commercialAccount                CommercialAccount @relation(fields: [commercial_account_id], references: [id])
  contract_id                      String
  contract                         Contract          @relation(fields: [contract_id], references: [id])
  price_book_id                    String
  priceBook                        PriceBook         @relation(fields: [price_book_id], references: [id])
  profile_key                      String
  version                          Int               @default(1)
  plan_sku                         String
  tenant_enabled                   Boolean           @default(false)
  allowed_use_case_keys            String            @default("[]")
  allowed_regions                  String            @default("[]")
  allowed_model_profile_ids        String            @default("[]")
  billable_metric                  String            @default("NON_BILLABLE")
  meter_key                        String?
  usage_authorization_id           String?
  catalog_version_id               String
  customer_authorization_ref       String?
  included_allowance               Decimal           @db.Decimal(14, 4)
  warning_threshold_percent        Int               @default(80)
  overage_policy                   String            @default("BLOCK")
  overage_cap                      Decimal?          @db.Decimal(14, 4)
  rate_limit_at_percent            Int               @default(100)
  fallback_allowed                 Boolean           @default(false)
  fallback_model_profile_ids       String            @default("[]")
  fallback_customer_charge_allowed Boolean           @default(false)
  fallback_authorization_ref       String?
  effective_from                   DateTime          @default(now())
  effective_to                     DateTime?
  status                           String            @default("PENDING_APPROVAL")
  approval_id                      String?           @unique
  requested_by                     String
  approved_by                      String?
  approved_at                      DateTime?
  activated_by                     String?
  activation_reference             String?
  activated_at                     DateTime?
  created_at                       DateTime          @default(now())
  updated_at                       DateTime          @updatedAt

  usageRecords       AiUsageRecord[]
  providerCostEvents AiProviderCostEvent[]

  @@unique([tenant_id, environment_id, profile_key, version])
  @@unique([tenant_id, environment_id, profile_key], map: "AiGovernanceProfile_one_active_key", where: raw("(status = 'ACTIVE'::text)"))
  @@index([tenant_id, environment_id, status])
  @@index([commercial_account_id, status])
  @@index([contract_id, status])

  @@schema("ai_governance")
}

model AiProviderCostEvent {
  id                     String               @id @default(uuid())
  tenant_id              String?
  environment_id         String?
  governance_profile_id  String?
  governanceProfile      AiGovernanceProfile? @relation(fields: [governance_profile_id], references: [id])
  provider               String
  model                  String
  model_class            String
  provider_price_version String
  prior_unit_cost        Decimal?             @db.Decimal(14, 6)
  new_unit_cost          Decimal              @db.Decimal(14, 6)
  cost_unit              String
  effective_at           DateTime
  source_reference       String
  customer_price_changed Boolean              @default(false)
  recorded_by            String
  created_at             DateTime             @default(now())

  @@unique([provider, model, provider_price_version, effective_at])
  @@index([tenant_id, environment_id, effective_at])
  @@index([governance_profile_id, effective_at])
  @@index([provider, model, effective_at])

  @@schema("ai_governance")
}

model AiBudget {
  id              String   @id @default(uuid())
  tenant_id       String
  environment_id  String   @default("UNBOUND")
  period_start    DateTime
  period_end      DateTime
  budget_amount   Decimal  @db.Decimal(14, 4)
  consumed_amount Decimal  @default(0) @db.Decimal(14, 4)
  status          String   @default("ACTIVE")
  created_at      DateTime @default(now())

  @@unique([tenant_id, environment_id, period_start, period_end], map: "AiBudget_one_active_period", where: raw("(status = 'ACTIVE'::text)"))
  @@index([tenant_id, environment_id])
  @@index([status])

  @@schema("ai_governance")
}

model DeterministicContinuityEvent {
  id                String   @id @default(uuid())
  tenant_id         String
  environment_id    String
  operation         String
  actor_id          String
  engine            String   @default("SHIELD_CORE_DETERMINISTIC_V1")
  llm_used          Boolean  @default(false)
  input_hash        String
  output_hash       String
  outcome           String
  reason            String
  authorization_ref String?
  created_at        DateTime @default(now())

  @@index([tenant_id, environment_id, created_at])
  @@index([operation, outcome, created_at])

  @@schema("ai_governance")
}
