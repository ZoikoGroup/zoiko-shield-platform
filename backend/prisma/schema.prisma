  irRetainer                    IncidentResponseRetainer?
  professionalServiceEngagement ProfessionalServiceEngagement?
  invoiceBases                  CommercialInvoiceLineBasis[]

  @@index([contract_id])
  @@index([tenant_id, environment_id, status])
  @@index([managed_defense_profile_id, status])
  @@index([status])
}

/**
