 */
model ManagedDefenseDeliveryEvent {
  id                         String                @id @default(uuid())
  tenant_id                  String
  environment_id             String
  managed_defense_profile_id String
  managedDefenseProfile      ManagedDefenseProfile @relation(fields: [managed_defense_profile_id], references: [id])
