generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ConnectorState {
  NOT_CONNECTED
  AWAITING_ADMIN_CONSENT
  CONNECTED
  SYNCING
  HEALTHY
  DEGRADED
  RATE_LIMITED
  PERMISSION_REVOKED
  AUTHENTICATION_FAILED
  CHECKPOINT_INVALID
  DISCONNECTED
}

model ConnectorDefinition {
  id              String   @id @default(uuid())
  provider        String   @unique // e.g., 'microsoft-entra'
  name            String
  description     String?
  supportedEvents String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  instances ConnectorInstance[]
}

model ConnectorInstance {
  id                   String              @id @default(uuid())
  tenant_id            String
  environment_id       String              @default("default-env")
  connectorDefId       String
  definition           ConnectorDefinition @relation(fields: [connectorDefId], references: [id])
  name                 String
  state                ConnectorState      @default(NOT_CONNECTED)
  authentication_type  String              @default("API_KEY")
  source_region        String?
  // Provider-side tenant identifier (e.g. the customer's Azure AD directory
  // ID) — distinct from source_region. Required to call back into the
  // provider's API again after initial consent.
  externalTenantId     String?
  region               String?
  configurationVersion Int                 @default(1)
  createdBy            String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?

  credentials       ConnectorCredentialReference[]
  permissions       ConnectorPermission[]
  checkpoints       ConnectorCheckpoint[]
  syncRuns          ConnectorSynchronizationRun[]
  health            ConnectorHealthStatus?
  errors            ConnectorError[]
  webhookSubs       WebhookSubscription[]
  eventHubChecks    EventHubConsumerCheckpoint[]
  quarantinedEvents QuarantinedEvent[]
  rawEvents         RawEvent[]

  @@index([tenant_id])
}

model ConnectorPermission {
  id                    String            @id @default(uuid())
  tenant_id             String
  instanceId            String
  instance              ConnectorInstance @relation(fields: [instanceId], references: [id])
  provider              String
  permission            String
  permissionType        String            @default("READ")
  granted               Boolean           @default(false)
  requiredForCapability String?
  verifiedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([instanceId, permission])
  @@index([tenant_id])
}

model ConnectorCredentialReference {
  id               String            @id @default(uuid())
  tenant_id        String
  instanceId       String
  instance         ConnectorInstance @relation(fields: [instanceId], references: [id])
  credentialType   String            @default("CLIENT_SECRET")
  vaultReferenceId String            @unique
  status           String            @default("ACTIVE")
  expiresAt        DateTime?
  rotatedAt        DateTime?
  createdAt        DateTime          @default(now())

  @@index([tenant_id])
}

model ConnectorCheckpoint {
  id              String            @id @default(uuid())
  tenant_id       String
  instanceId      String
  instance        ConnectorInstance @relation(fields: [instanceId], references: [id])
  resourceType    String
  checkpointValue String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([instanceId, resourceType])
  @@index([tenant_id])
}

model ConnectorSynchronizationRun {
  id                 String            @id @default(uuid())
  tenant_id          String
  instanceId         String
  instance           ConnectorInstance @relation(fields: [instanceId], references: [id])
  syncType           String?
  status             String
  startedAt          DateTime          @default(now())
  completedAt        DateTime?
  recordsReceived    Int               @default(0)
  recordsProcessed   Int               @default(0)
  recordsDuplicated  Int               @default(0)
  recordsQuarantined Int               @default(0)
  checkpointBefore   String?
  checkpointAfter    String?
  errorCode          String?

  @@index([tenant_id])
}

model ConnectorHealthStatus {
  id                         String            @id @default(uuid())
  tenant_id                  String
  instanceId                 String            @unique
  instance                   ConnectorInstance @relation(fields: [instanceId], references: [id])
  state                      ConnectorState
  lastMessage                String?
  permissionStatus           String            @default("UNKNOWN")
  credentialStatus           String            @default("UNKNOWN")
  consecutiveFailures        Int               @default(0)
  sourceLagSeconds           Int?
  lastSuccessfulConnectionAt DateTime?
  lastSuccessfulSyncAt       DateTime?
  lastErrorCode              String?
  updatedAt                  DateTime          @updatedAt

  @@index([tenant_id])
}

model ConnectorError {
  id         String            @id @default(uuid())
  tenant_id  String
  instanceId String
  instance   ConnectorInstance @relation(fields: [instanceId], references: [id])
  errorCode  String
  message    String
  createdAt  DateTime          @default(now())

  @@index([tenant_id])
}

model WebhookSubscription {
  id             String            @id @default(uuid())
  tenant_id      String
  instanceId     String
  instance       ConnectorInstance @relation(fields: [instanceId], references: [id])
  subscriptionId String
  clientState    String            @unique
  resource       String
  expiresAt      DateTime
  createdAt      DateTime          @default(now())

  @@index([tenant_id])
}

model EventHubConsumerCheckpoint {
  id             String            @id @default(uuid())
  tenant_id      String
  instanceId     String
  instance       ConnectorInstance @relation(fields: [instanceId], references: [id])
  partitionId    String
  offset         String
  sequenceNumber BigInt
  updatedAt      DateTime          @updatedAt

  @@unique([instanceId, partitionId])
  @@index([tenant_id])
}

model QuarantinedEvent {
  id         String            @id @default(uuid())
  tenant_id  String
  instanceId String
  instance   ConnectorInstance @relation(fields: [instanceId], references: [id])
  rawPayload String
  reason     String
  createdAt  DateTime          @default(now())

  @@index([tenant_id])
}

model RawEvent {
  id                    String            @id @default(uuid())
  tenant_id             String
  environment_id        String            @default("default-env")
  connector_id          String
  connector             ConnectorInstance @relation(fields: [connector_id], references: [id])
  source_type           String
  source_event_id       String?
  source_region         String?
  occurred_at           DateTime?
  received_at           DateTime          @default(now())
  payload_hash          String
  raw_payload_reference String
  schema_version        String            @default("v1.0")
  processing_status     String            @default("ACCEPTED")
  created_at            DateTime          @default(now())

  normalizedEvents NormalizedEvent[]

  @@unique([tenant_id, connector_id, source_event_id])
  @@index([tenant_id])
  @@index([connector_id])
  @@index([payload_hash])
}

model NormalizedEvent {
  id                   String          @id @default(uuid())
  tenant_id            String
  environment_id       String          @default("default-env")
  connector_id         String
  raw_event_id         String
  rawEvent             RawEvent        @relation(fields: [raw_event_id], references: [id])
  asset_id             String?
  asset                Asset?          @relation(fields: [asset_id], references: [id])
  identity_id          String?
  identity             IdentityEntity? @relation(fields: [identity_id], references: [id])
  event_class          String
  event_category       String?
  event_activity       String?
  severity             String          @default("INFORMATIONAL")
  actor_user_id        String?
  actor_email          String?
  source_ip            String?
  destination_ip       String?
  resource_id          String?
  resource_type        String?
  action               String?
  outcome              String?
  occurred_at          DateTime?
  observed_at          DateTime?
  recorded_at          DateTime        @default(now())
  mapping_version      String          @default("1.0")
  normalization_status String          @default("NORMALIZED")

  @@index([tenant_id])
  @@index([connector_id])
  @@index([raw_event_id])
  @@index([asset_id])
  @@index([identity_id])
}

model Asset {
  id             String   @id @default(uuid())
  tenant_id      String
  environment_id String   @default("default-env")
  external_id    String?
  asset_type     String
  name           String
  criticality    String   @default("MEDIUM")
  status         String   @default("ACTIVE")
  first_seen_at  DateTime @default(now())
  last_seen_at   DateTime @default(now())
  created_at     DateTime @default(now())

  normalizedEvents NormalizedEvent[]
  aliases          AssetAlias[]

  @@unique([tenant_id, external_id, asset_type])
  @@index([tenant_id])
  @@index([criticality])
}

model AssetAlias {
  id                String   @id @default(uuid())
  tenant_id         String
  asset_id          String
  asset             Asset    @relation(fields: [asset_id], references: [id])
  source_system     String
  source_account_id String?
  external_type     String
  external_id       String
  first_seen_at     DateTime @default(now())
  last_seen_at      DateTime @default(now())
  created_at        DateTime @default(now())

  @@unique([tenant_id, source_system, source_account_id, external_type, external_id])
  @@index([tenant_id])
  @@index([asset_id])
}

model IdentityEntity {
  id            String   @id @default(uuid())
  tenant_id     String
  external_id   String?
  email         String?
  display_name  String?
  identity_type String   @default("USER")
  status        String   @default("ACTIVE")
  confidence    Float    @default(1.0)
  first_seen_at DateTime @default(now())
  last_seen_at  DateTime @default(now())
  created_at    DateTime @default(now())

  normalizedEvents NormalizedEvent[]
  aliases          IdentityAlias[]

  @@unique([tenant_id, email])
  @@index([tenant_id])
  @@index([email])
}

model IdentityAlias {
  id                 String         @id @default(uuid())
  tenant_id          String
  identity_entity_id String
  identityEntity     IdentityEntity @relation(fields: [identity_entity_id], references: [id])
  source_system      String
  source_account_id  String?
  external_type      String
  external_id        String
  normalized_value   String?
  first_seen_at      DateTime       @default(now())
  last_seen_at       DateTime       @default(now())
  created_at         DateTime       @default(now())

  @@unique([tenant_id, source_system, source_account_id, external_type, external_id])
  @@index([tenant_id])
  @@index([identity_entity_id])
}

model Relationship {
  id             String    @id @default(uuid())
  tenant_id      String
  environment_id String    @default("default-env")
  subject_type   String
  subject_id     String
  relation       String
  object_type    String
  object_id      String
  source         String
  confidence     Float     @default(1.0)
  first_seen_at  DateTime  @default(now())
  last_seen_at   DateTime  @default(now())
  valid_from     DateTime?
  valid_until    DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@unique([tenant_id, subject_type, subject_id, relation, object_type, object_id])
  @@index([tenant_id])
  @@index([subject_type, subject_id])
  @@index([object_type, object_id])
}

model ResolutionDecision {
  id                 String   @id @default(uuid())
  tenant_id          String
  entity_type        String
  source_system      String
  external_id        String
  resolved_entity_id String?
  decision           String
  confidence         Float    @default(1.0)
  resolver_version   String   @default("1.0")
  reason             String
  created_at         DateTime @default(now())

  @@index([tenant_id])
  @@index([entity_type])
}

model ContextSnapshot {
  id                 String   @id @default(uuid())
  tenant_id          String
  environment_id     String   @default("default-env")
  event_id           String
  identity_entity_id String?
  asset_id           String?
  relationship_refs  String   @default("[]")
  identity_risk      String?
  asset_criticality  String?
  source_versions    String   @default("{}")
  resolver_version   String   @default("1.0")
  context_health     String   @default("UNRESOLVED")
  created_at         DateTime @default(now())

  detectionEvaluations DetectionEvaluation[]

  @@index([tenant_id])
  @@index([event_id])
}

model DetectionDefinition {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  owner       String?
  category    String   @default("IDENTITY")
  status      String   @default("ACTIVE")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  versions DetectionVersion[]

  @@index([status])
}

model DetectionVersion {
  id                            String              @id @default(uuid())
  detection_definition_id       String
  detectionDefinition           DetectionDefinition @relation(fields: [detection_definition_id], references: [id])
  version                       Int
  status                        String              @default("DRAFT")
  severity                      String              @default("MEDIUM")
  rule_type                     String              @default("POINT")
  configuration                 String              @default("{}")
  required_event_types          String              @default("[]")
  required_fields               String              @default("[]")
  required_context              String              @default("[]")
  allowed_missing_data_behavior String              @default("INDETERMINATE")
  effective_from                DateTime?
  published_at                  DateTime?
  created_at                    DateTime            @default(now())

  evaluations DetectionEvaluation[]
  matches     DetectionMatch[]
  replays     DetectionReplay[]

  @@unique([detection_definition_id, version])
  @@index([status])
}

model DetectionEvaluation {
  id                     String           @id @default(uuid())
  tenant_id              String
  environment_id         String           @default("default-env")
  detection_version_id   String
  detectionVersion       DetectionVersion @relation(fields: [detection_version_id], references: [id])
  // Plain scalar reference, deliberately not a Prisma relation — shield-core
  // never queries the shield-ingest-owned NormalizedEvent table directly.
  event_id               String
  context_snapshot_id    String?
  contextSnapshot        ContextSnapshot? @relation(fields: [context_snapshot_id], references: [id])
  evaluated_at           DateTime         @default(now())
  result                 String
  factor_snapshot        String           @default("[]")
  confidence             Float?
  incomplete_data        Boolean          @default(false)
  reason_code            String?
  correlation_id         String
  created_at             DateTime         @default(now())
  // Frozen event.normalized.v1 payload as consumed — replay reconstructs
  // from this, never from a live NormalizedEvent read (shield-core does
  // not query shield-ingest-owned tables).
  event_payload_snapshot String           @default("{}")

  replays DetectionReplay[]

  @@index([tenant_id])
  @@index([detection_version_id])
  @@index([event_id])
  @@index([result])
}

model DetectionMatch {
  id                      String           @id @default(uuid())
  tenant_id               String
  environment_id          String           @default("default-env")
  detection_definition_id String
  detection_version_id    String
  detectionVersion        DetectionVersion @relation(fields: [detection_version_id], references: [id])
  primary_event_id        String
  supporting_event_refs   String           @default("[]")
  context_snapshot_id     String?
  severity                String
  confidence              Float?
  factor_contributions    String           @default("[]")
  incomplete_data         Boolean          @default(false)
  occurred_at             DateTime
  detected_at             DateTime         @default(now())
  correlation_id          String
  created_at              DateTime         @default(now())

  @@unique([tenant_id, detection_version_id, primary_event_id, context_snapshot_id])
  @@index([tenant_id])
  @@index([detection_definition_id])
}

model DetectionReplay {
  id                     String              @id @default(uuid())
  tenant_id              String
  original_evaluation_id String
  originalEvaluation     DetectionEvaluation @relation(fields: [original_evaluation_id], references: [id])
  detection_version_id   String
  detectionVersion       DetectionVersion    @relation(fields: [detection_version_id], references: [id])
  replayed_at            DateTime            @default(now())
  original_result        String
  replay_result          String
  divergence             Boolean             @default(false)
  reason                 String?
  created_at             DateTime            @default(now())

  @@index([tenant_id])
  @@index([original_evaluation_id])
}

model Alert {
  id                      String    @id @default(uuid())
  tenant_id               String
  environment_id          String    @default("default-env")
  region                  String    @default("unspecified")
  detection_definition_id String
  detection_version_id    String
  detection_match_id      String
  title                   String
  description             String?
  severity                String    @default("HIGH")
  priority                String    @default("P2")
  confidence              Float     @default(0.9)
  status                  String    @default("NEW")
  source_event_ids        String    @default("[]")
  affected_assets         String    @default("[]")
  affected_identities     String    @default("[]")
  primary_identity_id     String?
  primary_asset_id        String?
  context_snapshot_id     String?
  incomplete_data         Boolean   @default(false)
  coverage_state          String    @default("UNKNOWN")
  assigned_to             String?
  assigned_queue          String?
  correlation_id          String?
  created_by              String    @default("system")
  acknowledged_at         DateTime?
  resolved_at             DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  assignments AlertAssignment[]

  @@unique([tenant_id, detection_match_id])
  @@index([tenant_id])
  @@index([status])
  @@index([severity])
}

model AlertAssignment {
  id           String   @id @default(uuid())
  tenant_id    String
  alert_id     String
  alert        Alert    @relation(fields: [alert_id], references: [id])
  queue_id     String?
  principal_id String?
  assigned_by  String
  assigned_at  DateTime @default(now())
  reason       String?

  @@index([tenant_id])
  @@index([alert_id])
}

model AlertSuppressionRule {
  id                      String    @id @default(uuid())
  tenant_id               String
  detection_definition_id String?
  identity_id             String?
  asset_id                String?
  condition               String    @default("{}")
  reason                  String
  starts_at               DateTime  @default(now())
  expires_at              DateTime?
  approved_by             String
  status                  String    @default("ACTIVE")
  created_at              DateTime  @default(now())

  @@index([tenant_id])
  @@index([detection_definition_id])
  @@index([status])
}

model OutboxEvent {
  id             String    @id @default(uuid())
  tenant_id      String
  topic          String
  event_type     String
  payload        String
  correlation_id String?
  created_at     DateTime  @default(now())
  published_at   DateTime?

  @@index([tenant_id])
  @@index([published_at])
}

model InboxEvent {
  id           String   @id @default(uuid())
  event_id     String   @unique
  topic        String
  tenant_id    String
  processed_at DateTime @default(now())

  @@index([tenant_id])
}

model Case {
  id                  String    @id @default(uuid())
  tenant_id           String
  environment_id      String    @default("default-env")
  region              String    @default("unspecified")
  title               String
  description         String?
  severity            String    @default("HIGH")
  priority            String    @default("P2")
  status              String    @default("NEW")
  owner_id            String?
  queue_id            String?
  primary_identity_id String?
  primary_asset_id    String?
  sla_started_at      DateTime?
  acknowledged_at     DateTime?
  resolved_at         DateTime?
  closed_at           DateTime?
  disposition         String?
  incident_id         String?
  correlation_id      String?
  created_by          String
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  alerts          CaseAlert[]
  transitions     CaseTransition[]
  timelineEntries CaseTimelineEntry[]
  notes           CaseNote[]
  hypotheses      InvestigationHypothesis[]
  decisions       CaseDecision[]
  evidenceLinks   CaseEvidence[]

  @@index([tenant_id])
  @@index([status])
}

model CaseAlert {
  tenant_id         String
  case_id           String
  case              Case     @relation(fields: [case_id], references: [id])
  alert_id          String
  linked_at         DateTime @default(now())
  linked_by         String
  relationship_type String   @default("PRIMARY")

  @@id([case_id, alert_id])
  @@index([tenant_id])
  @@index([alert_id])
}

model CaseTransition {
  id                        String   @id @default(uuid())
  tenant_id                 String
  case_id                   String
  case                      Case     @relation(fields: [case_id], references: [id])
  from_state                String
  to_state                  String
  actor_id                  String
  reason                    String
  occurred_at               DateTime @default(now())
  authorization_decision_id String?
  correlation_id            String?

  @@index([tenant_id])
  @@index([case_id])
}

model CaseTimelineEntry {
  id             String   @id @default(uuid())
  tenant_id      String
  case_id        String
  case           Case     @relation(fields: [case_id], references: [id])
  entry_type     String
  actor_id       String
  occurred_at    DateTime @default(now())
  title          String
  summary        String
  source_ref     String?
  evidence_ref   String?
  correlation_id String?
  created_at     DateTime @default(now())

  @@index([tenant_id])
  @@index([case_id])
}

model CaseNote {
  id             String   @id @default(uuid())
  tenant_id      String
  case_id        String
  case           Case     @relation(fields: [case_id], references: [id])
  author_id      String
  content        String
  classification String   @default("INTERNAL")
  created_at     DateTime @default(now())
  supersedes_id  String?

  @@index([tenant_id])
  @@index([case_id])
}

model InvestigationHypothesis {
  id                          String    @id @default(uuid())
  tenant_id                   String
  case_id                     String
  case                        Case      @relation(fields: [case_id], references: [id])
  statement                   String
  status                      String    @default("OPEN")
  created_by                  String
  supporting_evidence_refs    String    @default("[]")
  contradicting_evidence_refs String    @default("[]")
  created_at                  DateTime  @default(now())
  resolved_at                 DateTime?

  @@index([tenant_id])
  @@index([case_id])
}

model CaseDecision {
  id             String   @id @default(uuid())
  tenant_id      String
  case_id        String
  case           Case     @relation(fields: [case_id], references: [id])
  decision_type  String
  decision       String
  rationale      String
  actor_id       String
  evidence_refs  String   @default("[]")
  policy_version String?
  created_at     DateTime @default(now())

  @@index([tenant_id])
  @@index([case_id])
}

model EvidenceRecord {
  id                       String    @id @default(uuid())
  tenant_id                String
  environment_id           String    @default("default-env")
  legal_entity_id          String?
  region                   String    @default("unspecified")
  evidence_type            String
  producing_service        String
  source_system_id         String
  source_object_id         String
  collector_id             String?
  collector_version        String?
  source_observed_at       DateTime?
  received_at              DateTime  @default(now())
  period_start             DateTime?
  period_end               DateTime?
  purpose                  String
  data_class               String    @default("INTERNAL")
  content_hash             String
  hash_algorithm           String    @default("SHA-256")
  canonicalization_profile String    @default("zs-json-v1")
  media_type               String    @default("application/json")
  size_bytes               Int?
  vault_reference          String?
  integrity_state          String    @default("PENDING")
  freshness_state          String    @default("CURRENT")
  completeness_state       String    @default("UNKNOWN")
  retention_profile        String    @default("STANDARD")
  superseded_by_id         String?
  created_at               DateTime  @default(now())

  caseLinks     CaseEvidence[]
  alertLinks    AlertEvidence[]
  ledgerEntries EvidenceLedgerEntry[]

  @@index([tenant_id])
  @@index([source_system_id])
}

model CaseEvidence {
  id           String         @id @default(uuid())
  tenant_id    String
  case_id      String
  case         Case           @relation(fields: [case_id], references: [id])
  evidence_id  String
  evidence     EvidenceRecord @relation(fields: [evidence_id], references: [id])
  relationship String         @default("SOURCE")
  added_by     String
  added_at     DateTime       @default(now())
  note         String?

  @@index([tenant_id])
  @@index([case_id])
  @@index([evidence_id])
}

model AlertEvidence {
  tenant_id    String
  alert_id     String
  evidence_id  String
  evidence     EvidenceRecord @relation(fields: [evidence_id], references: [id])
  relationship String         @default("SOURCE")
  created_at   DateTime       @default(now())

  @@id([alert_id, evidence_id])
  @@index([tenant_id])
  @@index([evidence_id])
}

model EvidenceLineage {
  id                     String   @id @default(uuid())
  tenant_id              String
  evidence_id            String
  parent_evidence_id     String
  relationship           String
  transformation_type    String?
  transformation_version String?
  created_at             DateTime @default(now())

  @@index([tenant_id])
  @@index([evidence_id])
  @@index([parent_evidence_id])
}

model EvidenceLedgerEntry {
  id                       String         @id @default(uuid())
  tenant_id                String
  sequence                 Int
  evidence_id              String
  evidence                 EvidenceRecord @relation(fields: [evidence_id], references: [id])
  previous_entry_hash      String?
  entry_hash               String
  canonicalization_profile String         @default("zs-ledger-v1")
  created_at               DateTime       @default(now())

  @@unique([tenant_id, sequence])
  @@index([tenant_id])
  @@index([evidence_id])
}

model ResourceObservation {
  id                    String   @id @default(uuid())
  tenant_id             String
  environment_id        String   @default("default-env")
  canonical_resource_id String
  resource_type         String
  source_connector_id   String
  first_seen_at         DateTime @default(now())
  last_seen_at          DateTime @default(now())
  coverage_state        String   @default("DISCOVERED")
  billable_state        String   @default("NON_BILLABLE")
  exclusion_reason      String?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@unique([tenant_id, canonical_resource_id, resource_type])
  @@index([tenant_id])
  @@index([coverage_state])
}

model UsageRecord {
  id                     String   @id @default(uuid())
  tenant_id              String
  environment_id         String   @default("default-env")
  meter_version          String   @default("v1.0")
  source_type            String
  raw_event_id           String?
  unit                   String   @default("EVENTS")
  accepted_quantity      Int      @default(1)
  billable_quantity      Int      @default(0)
  usage_state            String   @default("ACCEPTED")
  billing_classification String   @default("COMMERCIAL_DIRECT")
  recorded_at            DateTime @default(now())

  @@index([tenant_id])
  @@index([usage_state])
  @@index([recorded_at])
}

model CommercialAccount {
  id                     String   @id @default(uuid())
  name                   String
  billing_source         String   @default("DIRECT")
  billing_classification String   @default("COMMERCIAL_DIRECT")
  status                 String   @default("ACTIVE")
  group_account_id       String?
  legal_entity_id        String?
  business_unit_id       String?
  environment_id         String?
  region                 String   @default("GLOBAL")
  residency_policy       String?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  entitlements Entitlement[]
  contracts    Contract[]
  invoices     CommercialInvoice[]
  quotes       CommercialQuote[]

  @@index([status])
  @@index([billing_classification])
}

model Entitlement {
  id                    String            @id @default(uuid())
  commercial_account_id String
  commercialAccount     CommercialAccount @relation(fields: [commercial_account_id], references: [id])
  tenant_id             String
  offer_type            String
  status                String            @default("ACTIVE")
  effective_from        DateTime          @default(now())
  effective_to          DateTime?
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt

  @@index([tenant_id])
  @@index([offer_type])
  @@index([status])
}

model ClaimRegister {
  id                String   @id @default(uuid())
  claim_key         String   @unique
  approved_wording  String
  status            String   @default("APPROVED")
  requires_evidence Boolean  @default(true)
  created_at        DateTime @default(now())
}

model CatalogVersion {
  id             String    @id @default(uuid())
  version_label  String    @unique
  status         String    @default("DRAFT")
  effective_from DateTime  @default(now())
  effective_to   DateTime?
  approved_by    String?
  approved_at    DateTime?
  created_at     DateTime  @default(now())

  products   Product[]
  priceBooks PriceBook[]
  contracts  Contract[]
  quotes     CommercialQuote[]

  @@index([status])
}

model Product {
  id                 String         @id @default(uuid())
  catalog_version_id String
  catalogVersion     CatalogVersion @relation(fields: [catalog_version_id], references: [id])
  sku                String
  offer_family       String
  display_name       String
  metric_family      String
  requires           String         @default("[]")
  incompatible_with  String         @default("[]")
  region_scope       String         @default("[]")
  created_at         DateTime       @default(now())

  priceBooks PriceBook[]

  @@unique([catalog_version_id, sku])
  @@index([sku])
}

model PriceBook {
  id                 String         @id @default(uuid())
  catalog_version_id String
  catalogVersion     CatalogVersion @relation(fields: [catalog_version_id], references: [id])
  product_id         String
  product            Product        @relation(fields: [product_id], references: [id])
  region             String         @default("GLOBAL")
  currency           String         @default("USD")
  channel            String         @default("DIRECT")
  unit_price         Float          @default(0.0)
  minimum_commit     Float          @default(0.0)
  overage_rate       Float          @default(0.0)
  status             String         @default("DRAFT")
  effective_from     DateTime       @default(now())
  effective_to       DateTime?
  margin_gate_passed Boolean        @default(false)
  created_at         DateTime       @default(now())

  @@index([status])
  @@index([product_id])
}

model Contract {
  id                    String            @id @default(uuid())
  commercial_account_id String
  commercialAccount     CommercialAccount @relation(fields: [commercial_account_id], references: [id])
  catalog_version_id    String
  catalogVersion        CatalogVersion    @relation(fields: [catalog_version_id], references: [id])
  term_start            DateTime          @default(now())
  term_end              DateTime
  status                String            @default("DRAFT")
  snapshot_hash         String            @default("sha256-snapshot")
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt

  serviceObligations ServiceObligation[]
  commercialInvoices CommercialInvoice[]

  @@index([commercial_account_id])
  @@index([status])
}

model ProtectedResourceDefinition {
  id                String    @id @default(uuid())
  resource_type     String
  version           Int       @default(1)
  identity_key_spec String    @default("{}")
  ephemeral_policy  String    @default("{}")
  status            String    @default("DRAFT")
  approved_by       String?
  approved_at       DateTime?
  created_at        DateTime  @default(now())

  @@unique([resource_type, version])
  @@index([status])
}

model ServiceObligation {
  id              String    @id @default(uuid())
  contract_id     String
  contract        Contract  @relation(fields: [contract_id], references: [id])
  obligation_type String
  coverage_window String?
  status          String    @default("NOT_DUE")
  due_at          DateTime?
  delivered_at    DateTime?
  evidence_ref    String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@index([contract_id])
  @@index([status])
}

model CommercialInvoice {
  id                    String            @id @default(uuid())
  commercial_account_id String
  commercialAccount     CommercialAccount @relation(fields: [commercial_account_id], references: [id])
  contract_id           String
  contract              Contract          @relation(fields: [contract_id], references: [id])
  status                String            @default("DRAFT")
  currency              String            @default("USD")
  total_amount          Float             @default(0.0)
  issued_at             DateTime?
  immutable_snapshot    String            @default("{}")
  // Part 10/11: FX + tax result are captured at issue time and never
  // rewritten afterward — original legal invoice values stay frozen.
  fx_rate               Decimal?          @db.Decimal(18, 8)
  fx_source              String?
  fx_effective_at        DateTime?
  tax_result             String           @default("{}")
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt

  lines       CommercialInvoiceLine[]
  creditNotes CommercialCreditNote[]
  debitNotes  CommercialDebitNote[]
  payments    Payment[]

  @@index([commercial_account_id])
  @@index([contract_id])
  @@index([status])
}

model CommercialInvoiceLine {
  id                    String   @id @default(uuid())
  invoice_id            String
  invoice               CommercialInvoice @relation(fields: [invoice_id], references: [id])
  sku                   String
  contract_id           String
  subscription_id       String?
  service_period_start  DateTime
  service_period_end    DateTime
  quantity              Int      @default(1)
  unit_price            Decimal  @db.Decimal(14, 4)
  discount_percent      Decimal  @default(0) @db.Decimal(5, 2)
  tax_amount            Decimal  @default(0) @db.Decimal(14, 4)
  tax_rule_id           String?
  currency              String   @default("USD")
  source_version        String   @default("v1")
  created_at            DateTime @default(now())

  @@index([invoice_id])
}

/** Part 12: corrections to an issued invoice are append-only, never edits. */
model CommercialCreditNote {
  id         String    @id @default(uuid())
  invoice_id String
  invoice    CommercialInvoice @relation(fields: [invoice_id], references: [id])
  amount     Decimal   @db.Decimal(14, 4)
  currency   String    @default("USD")
  reason     String
  status     String    @default("DRAFT")
  issued_at  DateTime?
  created_at DateTime  @default(now())

  @@index([invoice_id])
}

model CommercialDebitNote {
  id         String    @id @default(uuid())
  invoice_id String
  invoice    CommercialInvoice @relation(fields: [invoice_id], references: [id])
  amount     Decimal   @db.Decimal(14, 4)
  currency   String    @default("USD")
  reason     String
  status     String    @default("DRAFT")
  issued_at  DateTime?
  created_at DateTime  @default(now())

  @@index([invoice_id])
}

/** Part 10: fail-closed tax resolution — never a hardcoded global rate. */
model TaxRule {
  id                String    @id @default(uuid())
  jurisdiction      String
  product_tax_class String
  rate_percent      Decimal   @db.Decimal(6, 4)
  reverse_charge    Boolean   @default(false)
  status            String    @default("DRAFT")
  effective_from    DateTime  @default(now())
  effective_to      DateTime?
  approved_by       String?
  approved_at       DateTime?
  created_at        DateTime  @default(now())

  @@index([jurisdiction, product_tax_class])
  @@index([status])
}

// ============================================================
// ZS-COM-BILL-001 P0.3 Part 9: payment domain. No raw PAN/CVC is ever
// stored — payment_method_reference holds only a provider-issued token.
// ============================================================

model PaymentMethodReference {
  id                     String   @id @default(uuid())
  commercial_account_id  String
  provider               String
  provider_token         String
  brand                  String?
  last4                  String?
  status                 String   @default("ACTIVE")
  created_at             DateTime @default(now())

  @@index([commercial_account_id])
}

model Payment {
  id                            String    @id @default(uuid())
  commercial_account_id         String
  invoice_id                    String
  invoice                       CommercialInvoice @relation(fields: [invoice_id], references: [id])
  provider                      String
  provider_payment_id           String?
  payment_method_reference_id   String?
  amount                        Decimal   @db.Decimal(14, 4)
  currency                      String    @default("USD")
  status                        String    @default("PENDING")
  idempotency_key               String    @unique
  created_at                    DateTime  @default(now())
  updated_at                    DateTime  @updatedAt

  refunds Refund[]

  @@index([commercial_account_id])
  @@index([invoice_id])
  @@index([status])
}

model Refund {
  id         String   @id @default(uuid())
  payment_id String
  payment    Payment  @relation(fields: [payment_id], references: [id])
  amount     Decimal  @db.Decimal(14, 4)
  currency   String   @default("USD")
  reason     String
  status     String   @default("PENDING")
  created_at DateTime @default(now())

  @@index([payment_id])
}

model CommercialEvent {
  id              String    @id @default(uuid())
  event_type      String
  tenant_id       String?
  actor           String?
  payload         String
  idempotency_key String    @unique
  created_at      DateTime  @default(now())
  published_at    DateTime?

  @@index([idempotency_key])
  @@index([event_type])
}

// ============================================================
// ZS-COM-BILL-001 P0.1: CPQ chain (Quote -> Order -> Subscription),
// maker-checker commercial approvals, and a reusable idempotency ledger.
// ============================================================

model CommercialQuote {
  id                     String    @id @default(uuid())
  commercial_account_id  String
  commercialAccount      CommercialAccount @relation(fields: [commercial_account_id], references: [id])
  catalog_version_id     String
  catalogVersion         CatalogVersion    @relation(fields: [catalog_version_id], references: [id])
  status                 String    @default("DRAFT")
  currency               String    @default("USD")
  region                 String    @default("GLOBAL")
  term_months            Int       @default(12)
  requires_approval      Boolean   @default(false)
  approval_id            String?
  snapshot               String    @default("{}")
  requested_by           String
  approved_by            String?
  approved_at            DateTime?
  rejected_reason        String?
  expires_at             DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  lines  CommercialQuoteLine[]
  orders CommercialOrder[]

  @@index([commercial_account_id])
  @@index([status])
}

model CommercialQuoteLine {
  id                     String   @id @default(uuid())
  quote_id               String
  quote                  CommercialQuote @relation(fields: [quote_id], references: [id])
  product_id             String
  price_book_id          String
  quantity               Int      @default(1)
  unit_price             Decimal  @db.Decimal(14, 4)
  line_discount_percent  Decimal  @default(0) @db.Decimal(5, 2)
  created_at             DateTime @default(now())

  @@index([quote_id])
}

model CommercialOrder {
  id                     String   @id @default(uuid())
  quote_id               String
  quote                  CommercialQuote @relation(fields: [quote_id], references: [id])
  commercial_account_id  String
  status                 String   @default("CREATED")
  contract_id            String?  @unique
  idempotency_key        String   @unique
  created_by             String
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  lines CommercialOrderLine[]

  @@index([commercial_account_id])
  @@index([status])
}

model CommercialOrderLine {
  id         String   @id @default(uuid())
  order_id   String
  order      CommercialOrder @relation(fields: [order_id], references: [id])
  product_id String
  quantity   Int      @default(1)
  unit_price Decimal  @db.Decimal(14, 4)
  created_at DateTime @default(now())

  @@index([order_id])
}

model CommercialSubscription {
  id                     String    @id @default(uuid())
  order_id               String    @unique
  commercial_account_id  String
  contract_id            String
  status                 String    @default("PENDING")
  effective_from         DateTime?
  effective_to           DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  amendments CommercialAmendment[]

  @@index([commercial_account_id])
  @@index([status])
}

model CommercialAmendment {
  id                 String    @id @default(uuid())
  subscription_id    String
  subscription       CommercialSubscription @relation(fields: [subscription_id], references: [id])
  amendment_type     String
  status             String    @default("REQUESTED")
  effective_at       DateTime?
  before_snapshot    String    @default("{}")
  proposed_snapshot  String    @default("{}")
  requested_by       String
  approved_by        String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  @@index([subscription_id])
  @@index([status])
}

model CommercialApproval {
  id                      String    @id @default(uuid())
  change_type             String
  object_type             String
  object_id               String
  requested_by            String
  requested_at            DateTime  @default(now())
  reason                  String
  before_snapshot         String    @default("{}")
  proposed_snapshot       String    @default("{}")
  financial_impact        Decimal?  @db.Decimal(14, 4)
  margin_impact           Decimal?  @db.Decimal(6, 4)
  required_approval_role  String    @default("BILLING_ADMIN")
  status                  String    @default("PENDING_APPROVAL")
  approved_by             String?
  approved_at             DateTime?
  decision_reason         String?
  expires_at              DateTime?
  applied_at              DateTime?
  idempotency_key         String?   @unique

  @@index([object_type, object_id])
  @@index([status])
}

model IdempotencyRecord {
  id                   String    @id @default(uuid())
  idempotency_key      String
  operation            String
  tenant_id            String?
  actor_id             String?
  request_fingerprint  String
  status               String    @default("IN_PROGRESS")
  response_code        Int?
  response_body        String?
  created_at           DateTime  @default(now())
  expires_at           DateTime?

  @@unique([idempotency_key, operation])
}

// ============================================================
// ZS-COM-BILL-001 P0.2: resource dedup / protected-resource coverage engine
// and telemetry metering engine (accepted != billable).
// ============================================================

model MeterDefinition {
  id                 String    @id @default(uuid())
  meter_key          String
  version            Int       @default(1)
  unit               String    @default("EVENTS")
  source_scope       String    @default("[]")
  aggregation_window String    @default("DAILY")
  dedupe_policy      String    @default("SOURCE_EVENT_ID")
  included_quantity  Int       @default(0)
  billable_policy    String    @default("STANDARD")
  status             String    @default("DRAFT")
  effective_from     DateTime  @default(now())
  effective_to       DateTime?
  approved_by        String?
  approved_at        DateTime?
  created_at         DateTime  @default(now())

  events MeterEvent[]

  @@unique([meter_key, version])
  @@index([status])
}

model MeterEvent {
  id                    String   @id @default(uuid())
  tenant_id             String
  meter_definition_id   String
  meterDefinition       MeterDefinition @relation(fields: [meter_definition_id], references: [id])
  source                String
  source_event_id       String
  occurred_at           DateTime
  received_at           DateTime @default(now())
  quantity              Int      @default(1)
  unit                  String   @default("EVENTS")
  accepted_state        String   @default("RECEIVED")
  billable_state        String   @default("NON_BILLABLE")
  dedupe_key            String
  is_platform_generated Boolean  @default(false)
  correction_of_event_id String?
  created_at            DateTime @default(now())

  @@index([tenant_id, meter_definition_id, dedupe_key])
  @@index([tenant_id])
  @@index([accepted_state])
}

// ============================================================
// ZS-COM-BILL-001 P0.4 Part 18: dunning engine. Policy-driven, versioned,
// fail-closed — no hardcoded grace/restriction/suspension timings.
// Deliberately has zero knowledge of evidence/incidents/exports: payment
// failure must never be able to touch those domains from here.
// ============================================================

model DunningPolicy {
  id                   String    @id @default(uuid())
  policy_key           String
  version              Int       @default(1)
  grace_period_days    Int       @default(7)
  restrict_after_days  Int       @default(14)
  suspend_after_days   Int       @default(30)
  terminate_after_days Int       @default(60)
  status               String    @default("DRAFT")
  approved_by          String?
  approved_at          DateTime?
  created_at           DateTime  @default(now())

  @@unique([policy_key, version])
  @@index([status])
}

model DunningCase {
  id                  String    @id @default(uuid())
  contract_id         String
  dunning_policy_id   String
  status              String    @default("ACTIVE")
  triggered_at        DateTime  @default(now())
  last_action_at      DateTime  @default(now())
  resolved_at         DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@index([contract_id])
  @@index([status])
}

// ============================================================
// ZS-COM-BILL-001 P1 Part 13: SLA / service credit engine. SVC-04/FIN-04 —
// credits are evidence-linked, approved through the generic maker-checker
// engine, and posted only as an append-only credit note against an
// already-issued invoice. Never rewrites security/incident history.
// ============================================================

model SlaDefinition {
  id                  String    @id @default(uuid())
  sla_key             String
  version             Int       @default(1)
  metric              String
  /** MIN: measured value must be >= target (e.g. uptime). MAX: measured value must be <= target (e.g. response time). */
  comparison          String    @default("MIN")
  target_value        Decimal   @db.Decimal(10, 4)
  service_tier        String    @default("STANDARD")
  region              String    @default("GLOBAL")
  measurement_window  String    @default("MONTHLY")
  credit_formula      String    @default("{}")
  dispute_window_days Int       @default(30)
  status              String    @default("DRAFT")
  approved_by         String?
  approved_at         DateTime?
  effective_from      DateTime  @default(now())
  effective_to        DateTime?
  created_at          DateTime  @default(now())

  measurements SlaMeasurement[]

  @@unique([sla_key, version])
  @@index([status])
}

model SlaMeasurement {
  id                  String   @id @default(uuid())
  sla_definition_id   String
  slaDefinition       SlaDefinition @relation(fields: [sla_definition_id], references: [id])
  contract_id         String
  period_start        DateTime
  period_end          DateTime
  measured_value      Decimal  @db.Decimal(10, 4)
  breached            Boolean  @default(false)
  evidence_ref        String?
  measurement_source  String   @default("SYSTEM")
  created_at          DateTime @default(now())

  serviceCredits ServiceCredit[]

  @@index([contract_id])
  @@index([sla_definition_id])
}

model ServiceCredit {
  id                  String    @id @default(uuid())
  sla_measurement_id  String
  slaMeasurement      SlaMeasurement @relation(fields: [sla_measurement_id], references: [id])
  contract_id         String
  amount              Decimal   @db.Decimal(14, 4)
  currency            String    @default("USD")
  status              String    @default("PROPOSED")
  approval_id         String?
  credit_note_id      String?
  posted_at           DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@index([contract_id])
  @@index([status])
}

// ============================================================
// ZS-COM-BILL-001 P1 Part 15: IR retainer work orders. Consumption is
// tracked continuously; overage past included_hours never silently bills
// — it is either capped, blocked, or gated on an approved OVERAGE_OVERRIDE
// commercial approval, per overage_policy.
// ============================================================

model IncidentWorkOrder {
  id                 String    @id @default(uuid())
  contract_id        String
  incident_reference String
  activation_reason  String
  response_authority String    @default("R1")
  activated_at       DateTime  @default(now())
  authorized_by      String
  included_hours     Decimal   @default(0) @db.Decimal(8, 2)
  consumed_hours     Decimal   @default(0) @db.Decimal(8, 2)
  overage_policy     String    @default("REQUIRE_APPROVAL")
  overage_cap_hours  Decimal?  @db.Decimal(8, 2)
  third_party_costs  Decimal   @default(0) @db.Decimal(14, 4)
  customer_contact   String?
  evidence_refs      String    @default("[]")
  status             String    @default("ACTIVE")
  closed_at          DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  @@index([contract_id])
  @@index([status])
}

// ============================================================
// ZS-COM-BILL-001 P1 Part 21: Partner/Reseller/MSP domain. Operational
// access (delegation) never implies commercial authority — pricing is
// never mutable through a delegation regardless of scope, and
// entitlement always derives from the accepted order, never the partner
// relationship directly.
// ============================================================

model Partner {
  id          String   @id @default(uuid())
  legal_name  String
  partner_type String
  status      String   @default("ACTIVE")
  created_at  DateTime @default(now())

  @@index([status])
}

model PartnerAgreement {
  id                      String    @id @default(uuid())
  partner_id              String
  commission_percent      Decimal   @default(0) @db.Decimal(5, 2)
  margin_percent          Decimal   @default(0) @db.Decimal(5, 2)
  invoice_responsibility  String    @default("ZOIKOSHIELD")
  tax_responsibility      String    @default("ZOIKOSHIELD")
  support_responsibility  String    @default("ZOIKOSHIELD")
  renewal_rights          String    @default("ZOIKOSHIELD")
  status                  String    @default("DRAFT")
  approved_by             String?
  approved_at             DateTime?
  effective_from          DateTime  @default(now())
  effective_to            DateTime?
  created_at              DateTime  @default(now())

  @@index([partner_id])
  @@index([status])
}

/** Explicit, tenant-scoped, revocable, expiring, non-transitive. Never grants pricing authority. */
model PartnerDelegation {
  id                     String    @id @default(uuid())
  partner_id             String
  commercial_account_id  String
  scope                  String    @default("[]")
  status                 String    @default("ACTIVE")
  granted_by             String
  expires_at             DateTime?
  revoked_at             DateTime?
  created_at             DateTime  @default(now())

  @@index([partner_id])
  @@index([commercial_account_id])
  @@index([status])
}

model PartnerSettlement {
  id                String   @id @default(uuid())
  partner_id        String
  period_start      DateTime
  period_end        DateTime
  gross_amount      Decimal  @db.Decimal(14, 4)
  commission_amount Decimal  @db.Decimal(14, 4)
  currency          String   @default("USD")
  status            String   @default("DRAFT")
  created_at        DateTime @default(now())

  @@index([partner_id])
  @@index([status])
}

// ============================================================
// ZS-COM-BILL-001 P1 Part 23 / REG-01: sector & framework packs. A pack is
// a support capability, never an automatic certification claim.
// Unsupported region/pack combinations fail closed.
// ============================================================

model SectorPack {
  id                     String    @id @default(uuid())
  pack_key               String
