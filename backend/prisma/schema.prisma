  evidence_bundle_id        String?
  evaluation_run_id         String?
  status                    String    @default("PENDING") // PENDING|EVIDENCE_INCOMPLETE|READY_FOR_EVALUATION|EVALUATED|REVIEW_REQUIRED|APPROVED|SUPERSEDED
  effectiveness             String    @default("UNKNOWN") // EFFECTIVE|PARTIALLY_EFFECTIVE|INEFFECTIVE|UNKNOWN
  completeness_state        String    @default("UNKNOWN")
  freshness_state           String    @default("UNKNOWN")
  integrity_state           String    @default("UNKNOWN")
  performer_id              String?
  reviewer_id               String?
  reviewed_at               DateTime?
  limitations               String    @default("[]")
  version                   Int       @default(1)
  created_at                DateTime  @default(now())

  @@index([tenant_id])
  @@index([control_implementation_id])
}

// --- shield-core-owned: risk & exception management ---
model ControlDeficiency {
  id                   String    @id @default(uuid())
  tenant_id            String
  assessment_id        String
  control_objective_id String
  type                 String // DESIGN_GAP|IMPLEMENTATION_GAP|OPERATING_FAILURE|EVIDENCE_GAP|COVERAGE_GAP
  severity             String
  description          String
  evidence_refs        String    @default("[]")
  owner_id             String
  status               String    @default("OPEN")
  detected_at          DateTime  @default(now())
  due_at               DateTime?
  resolved_at          DateTime?

  @@index([tenant_id])
  @@index([assessment_id])
}

model Risk {
  id            String   @id @default(uuid())
  tenant_id     String
  title         String
  description   String
  source_type   String
  source_id     String
  likelihood    String
  impact        String
  inherent_risk String?
  residual_risk String?
  status        String   @default("OPEN")
  owner_id      String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  factors     RiskFactor[]
  treatments  RiskTreatment[]
  acceptances RiskAcceptance[]

  @@index([tenant_id])
}

model RiskFactor {
  id                String   @id @default(uuid())
  tenant_id         String
  risk_id           String
  risk              Risk     @relation(fields: [risk_id], references: [id])
  factor            String
  value             String
  contribution      Float
  source_ref        String
  evaluator_version String?
  created_at        DateTime @default(now())

  @@index([tenant_id])
  @@index([risk_id])
}

model RiskTreatment {
  id             String    @id @default(uuid())
  tenant_id      String
  risk_id        String
  risk           Risk      @relation(fields: [risk_id], references: [id])
  treatment_type String // MITIGATE|TRANSFER|AVOID|ACCEPT
  plan           String
  owner_id       String
  due_at         DateTime?
  status         String    @default("PLANNED")
  created_at     DateTime  @default(now())

  @@index([tenant_id])
  @@index([risk_id])
}

// Immutable version rows (bitemporal) — same shape/semantics as ControlMapping.
model RiskAcceptance {
  id                    String    @id @default(uuid())
  tenant_id             String
  risk_id               String
  risk                  Risk      @relation(fields: [risk_id], references: [id])
  accepted_by           String
  authority             String
  rationale             String
  compensating_controls String    @default("[]")
  valid_from            DateTime
  valid_to              DateTime?
  recorded_at           DateTime  @default(now())
  supersedes_id         String?
  expires_at            DateTime
  review_at             DateTime
  status                String    @default("ACTIVE")

  @@index([tenant_id])
  @@index([risk_id])
}

model Exception {
  id                        String   @id @default(uuid())
  tenant_id                 String
  control_objective_id      String?
  control_implementation_id String?
  requirement_id            String?
  risk_id                   String?
  reason                    String
  scope                     String   @default("{}")
  compensating_controls     String   @default("[]")
  requested_by              String
  approved_by               String?
  starts_at                 DateTime
  expires_at                DateTime
  status                    String   @default("REQUESTED") // REQUESTED|APPROVED|REJECTED|EXPIRED|REVOKED
  created_at                DateTime @default(now())

  @@index([tenant_id])
}

// --- shield-core-owned: audit package ---
model AuditPackage {
  id                    String    @id @default(uuid())
  tenant_id             String
  version               Int       @default(1)
  purpose               String
  framework_scope       String    @default("[]")
  legal_entity_scope    String?
  environment_scope     String?
  period_start          DateTime
  period_end            DateTime
  status                String    @default("DRAFT") // DRAFT|BUILDING|VALIDATING|INCOMPLETE|READY_FOR_REVIEW|APPROVED|REAPPROVAL_REQUIRED|FROZEN|SUPERSEDED|FAILED
  created_by            String
  created_at            DateTime  @default(now())
  frozen_at             DateTime?
  approved_by           String?
  approved_at           DateTime?
  supersedes_package_id String?

  manifest  AuditPackageManifest?
  approvals AuditPackageApproval[]

  @@index([tenant_id])
}

// The exact manifestCoreHash a human approved — immutable once written.
model AuditPackageApproval {
  id                        String       @id @default(uuid())
  tenant_id                 String
  package_id                String
  package                   AuditPackage @relation(fields: [package_id], references: [id])
  package_version           Int
  approver_id               String
  manifest_core_hash        String
  authorization_decision_id String
  approved_at               DateTime     @default(now())

  @@index([tenant_id])
  @@index([package_id])
}

model AuditPackageManifest {
  id                       String       @id @default(uuid())
  package_id               String       @unique
  package                  AuditPackage @relation(fields: [package_id], references: [id])
  package_version          Int
  manifest_core_content    String // JSON: ManifestCore (see plan) — everything except the anchor proof
  manifest_core_hash       String?
  proof_envelope_content   String? // JSON: checkpoint/merkle/signature/witnesses, filled only at freeze
  manifest_content         String? // JSON: core + proof merged, the final exported envelope
  package_envelope_hash    String?
  canonicalization_profile String       @default("zs-manifest-v1")
  created_at               DateTime     @default(now())
}

// --- shield-anchor-owned: cryptographic checkpointing ---
// Its own strictly-increasing per-tenant sequence, independent of the
// evidence ledger's own sequence — anchoring is not the ledger sequencer.
model TenantAnchorHead {
  tenant_id            String  @id
  last_anchor_sequence Int     @default(0)
  last_checkpoint_id   String?
  last_checkpoint_hash String?
  version              Int     @default(0)
}

model Checkpoint {
  id                       String    @id @default(uuid())
  tenant_id                String
  anchor_sequence          Int
  ledger_sequence          Int
  ledger_head_hash         String
  package_id               String?
  package_version          Int?
  manifest_core_hash       String?
  leaf_hashes              String // JSON array
  merkle_root              String
  tree_profile             String    @default("ZS-MERKLE-V1")
  hash_algorithm           String    @default("SHA-256")
  canonicalization_profile String    @default("zs-checkpoint-v1")
  signing_key_id           String
  signature                String
  witness_assurance_state  String    @default("TEST_ONLY") // TEST_ONLY|WITNESS_PARTIAL|WITNESS_FULL
  status                   String    @default("PENDING") // PENDING|SIGNED|PUBLISHED|FAILED
  created_at               DateTime  @default(now())
  published_at             DateTime?

  witnessReceipts WitnessReceipt[]

  @@unique([tenant_id, anchor_sequence])
  @@index([tenant_id])
}

model SigningKey {
  id         String   @id @default(uuid())
  key_id     String   @unique
  algorithm  String   @default("Ed25519")
  public_key String
  status     String   @default("ACTIVE") // ACTIVE|RETIRED
  created_at DateTime @default(now())
}

model WitnessReceipt {
  id            String     @id @default(uuid())
  checkpoint_id String
  checkpoint    Checkpoint @relation(fields: [checkpoint_id], references: [id])
  witness_id    String
  witness_type  String     @default("MOCK")
  receipt_hash  String
  received_at   DateTime   @default(now())
  status        String     @default("RECEIVED")

  @@index([checkpoint_id])
}

// ============================================================
// Part 13+14: Reporting/Notifications + Developer API/Webhooks/Export/Offboarding
// ============================================================

// --- shield-core-owned: reporting (non-authoritative projections only) ---
model ReportDefinition {
  id                  String   @id @default(uuid())
  key                 String   @unique
  name                String
  report_type         String // OPERATIONAL|SECURITY|ASSURANCE|EXECUTIVE|BOARD|CUSTOMER_SERVICE
  version             String   @default("1.0")
  purpose             String
  audience            String
  source_requirements String   @default("[]")
  metric_definitions  String   @default("[]")
  status              String   @default("ACTIVE")
  created_at          DateTime @default(now())
}

model ReportingProjection {
  id                 String    @id @default(uuid())
  tenant_id          String
  environment_id     String?
  projection_type    String // SECURITY_POSTURE|CASE_POSTURE|CONNECTOR_HEALTH|CONTROL_POSTURE|RISK_POSTURE|AUDIT_PACKAGE_POSTURE|SERVICE_HEALTH|EXECUTIVE_POSTURE
  source_domain      String
  source_object_id   String
  source_version     String?
  source_occurred_at DateTime?
  source_recorded_at DateTime?
  freshness_state    String    @default("UNKNOWN")
  completeness_state String    @default("UNKNOWN")
  health_state       String    @default("UNKNOWN") // HEALTHY|PARTIAL|STALE|DEGRADED|UNKNOWN|UNAVAILABLE
  projection_version Int       @default(1)
  payload            String    @default("{}")
  last_reconciled_at DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  @@index([tenant_id])
  @@index([projection_type])
  @@index([source_domain, source_object_id])
}

model ReportSnapshot {
  id                        String   @id @default(uuid())
  tenant_id                 String
  environment_id            String?
  report_definition_id      String
  report_definition_version String
  period_start              DateTime
  period_end                DateTime
  generated_by              String
  source_snapshot_refs      String   @default("[]")
  source_versions           String   @default("[]")
  freshness_state           String   @default("UNKNOWN")
  completeness_state        String   @default("UNKNOWN")
  limitations               String   @default("[]")
  // Frozen payload the snapshot is hashed over — a snapshot must be
  // independently renderable without re-querying live domain tables.
  payload                   String   @default("{}")
  snapshot_hash             String
  status                    String   @default("BUILDING") // BUILDING|READY|PARTIAL|FAILED|SUPERSEDED
  generated_at              DateTime @default(now())

  @@index([tenant_id])
  @@index([report_definition_id])
}

model ExecutiveReportSnapshot {
  id                 String    @id @default(uuid())
  tenant_id          String
  report_snapshot_id String
  reporting_period   String
  metrics            String    @default("[]") // each entry: {key,value,factors[],weights,unknownInputs,sourceRefs,definitionRef}
  known_limitations  String    @default("[]")
  source_refs        String    @default("[]")
  approved_by        String?
  approved_at        DateTime?
  created_at         DateTime  @default(now())

  @@index([tenant_id])
  @@index([report_snapshot_id])
}

// --- shield-core-owned: notification ---
model NotificationPolicy {
  id                       String   @id @default(uuid())
  key                      String   @unique
  event_type               String
  audience_type            String
  severity                 String?
  mandatory                Boolean  @default(false)
  allowed_channels         String   @default("[]")
  acknowledgement_required Boolean  @default(false)
  escalation_policy        String?
  version                  Int      @default(1)
  status                   String   @default("ACTIVE")
  created_at               DateTime @default(now())
}

model NotificationTemplate {
  id               String    @id @default(uuid())
  key              String
  channel          String
  locale           String    @default("en-US")
  version          Int
  subject_template String?
  body_template    String
  status           String    @default("DRAFT")
  published_at     DateTime?
  created_at       DateTime  @default(now())

  @@unique([key, channel, locale, version])
}

model NotificationPreference {
  id                     String   @id @default(uuid())
  tenant_id              String
  principal_id           String
  notification_policy_id String
  channel                String
  enabled                Boolean  @default(true)
  quiet_hours            String?
  locale                 String?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  @@unique([tenant_id, principal_id, notification_policy_id, channel])
}

model NotificationChannelConfig {
  id                String   @id @default(uuid())
  tenant_id         String
  channel_type      String // IN_APP|EMAIL
  enabled           Boolean  @default(true)
  configuration_ref String?
  status            String   @default("ACTIVE")
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@unique([tenant_id, channel_type])
}

// Idempotency key = eventId + recipientPrincipalId + channel + notificationPolicyVersion (spec §18).
model NotificationDelivery {
  id                     String    @id @default(uuid())
  tenant_id              String
  event_id               String
  policy_id              String
  policy_version         Int
  recipient_principal_id String
  channel                String
  template_version       Int
  status                 String    @default("PENDING") // PENDING|PROCESSING|DELIVERED|FAILED|DEAD_LETTERED|CANCELLED
  attempt_count          Int       @default(0)
  first_attempt_at       DateTime?
  last_attempt_at        DateTime?
  delivered_at           DateTime?
  error_code             String?
  correlation_id         String
  created_at             DateTime  @default(now())

  acknowledgements NotificationAcknowledgement[]

  @@unique([event_id, recipient_principal_id, channel, policy_version])
  @@index([tenant_id])
}

model NotificationAcknowledgement {
  id                       String               @id @default(uuid())
  tenant_id                String
  notification_delivery_id String
  delivery                 NotificationDelivery @relation(fields: [notification_delivery_id], references: [id])
  principal_id             String
  acknowledgement_type     String // SEEN|ACKNOWLEDGED|ACCEPTED|DECLINED
  acknowledged_at          DateTime             @default(now())
  correlation_id           String

  @@index([tenant_id])
  @@index([notification_delivery_id])
}

// --- shield-core-owned: developer API (foundation built now, public surface G2-gated) ---
model ApiClient {
  id                String    @id @default(uuid())
  tenant_id         String
  name              String
  client_id         String    @unique
  principal_id      String    @unique
  status            String    @default("PENDING") // PENDING|ACTIVE|SUSPENDED|REVOKED|EXPIRED
  environment_scope String?
  purpose           String
  created_by        String
  expires_at        DateTime?
  last_used_at      DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  credentials ApiClientCredential[]
  scopeGrants ApiScopeGrant[]

  @@index([tenant_id])
}

// Raw secret is generated once, returned once, never stored — only a strong hash + fingerprint (spec §29).
model ApiClientCredential {
  id              String    @id @default(uuid())
  tenant_id       String
  api_client_id   String
  apiClient       ApiClient @relation(fields: [api_client_id], references: [id])
  secret_version  Int
  secret_hash     String
  fingerprint     String
  status          String    @default("ACTIVE") // ACTIVE|RETIRING|REVOKED
  issued_at       DateTime  @default(now())
  expires_at      DateTime?
  revoked_at      DateTime?
  rotated_from_id String?

  @@unique([api_client_id, secret_version])
  @@index([tenant_id])
}

model ApiScopeGrant {
  id                        String    @id @default(uuid())
  tenant_id                 String
  api_client_id             String
  apiClient                 ApiClient @relation(fields: [api_client_id], references: [id])
  scope                     String
  environment_id            String?
  granted_by                String
  authorization_decision_id String
  effective_from            DateTime  @default(now())
  expires_at                DateTime?
  revoked_at                DateTime?
  created_at                DateTime  @default(now())

  @@index([tenant_id])
  @@index([api_client_id])
}

// --- shield-core-owned: webhooks ---
model OutboundWebhookSubscription {
  id                        String    @id @default(uuid())
  tenant_id                 String
  api_client_id             String?
  endpoint_url              String
  event_types               String    @default("[]")
  payload_version           String    @default("1.0")
  data_minimization_profile String    @default("default")
  status                    String    @default("PENDING_VERIFICATION") // PENDING_VERIFICATION|ACTIVE|DEGRADED|SUSPENDED|REVOKED
  created_by                String
  verified_at               DateTime?
  suspended_at              DateTime?
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt

  secretVersions WebhookSecretVersion[]
  deliveries     WebhookDelivery[]

  @@index([tenant_id])
}

// Actual secret lives in vault only — this row is metadata + a vault reference (spec §44).
model WebhookSecretVersion {
  id                      String                      @id @default(uuid())
  tenant_id               String
  webhook_subscription_id String
  subscription            OutboundWebhookSubscription @relation(fields: [webhook_subscription_id], references: [id])
  version                 Int
  secret_ref              String
  fingerprint             String
  status                  String                      @default("ACTIVE") // ACTIVE|RETIRING|REVOKED
  created_at              DateTime                    @default(now())
  expires_at              DateTime?
  revoked_at              DateTime?

  @@unique([webhook_subscription_id, version])
  @@index([tenant_id])
}

model WebhookDelivery {
  id                      String                      @id @default(uuid())
  tenant_id               String
  webhook_subscription_id String
  subscription            OutboundWebhookSubscription @relation(fields: [webhook_subscription_id], references: [id])
  event_id                String
  event_type              String
  payload_version         String
  payload_hash            String
  // Frozen exact bytes sent on the first attempt — retries and replay must
  // resend the identical body, never a reconstructed approximation.
  payload                 String                      @default("{}")
  status                  String                      @default("PENDING") // PENDING|DELIVERING|DELIVERED|FAILED|DEAD_LETTERED
  attempt_count           Int                         @default(0)
  first_attempt_at        DateTime?
  last_attempt_at         DateTime?
  delivered_at            DateTime?
  response_status         Int?
  replay_of_delivery_id   String?
  correlation_id          String
  created_at              DateTime                    @default(now())

  attempts WebhookDeliveryAttempt[]

  @@index([tenant_id])
  @@index([webhook_subscription_id])
}

model WebhookDeliveryAttempt {
  id              String          @id @default(uuid())
  tenant_id       String
  delivery_id     String
  delivery        WebhookDelivery @relation(fields: [delivery_id], references: [id])
  attempt_number  Int
  started_at      DateTime        @default(now())
  completed_at    DateTime?
  response_status Int?
  error_class     String?
  retryable       Boolean         @default(true)
  duration_ms     Int?

  @@index([delivery_id])
}

// --- shield-core-owned: export ---
model ExportJob {
  id                        String    @id @default(uuid())
  tenant_id                 String
  environment_id            String?
  requested_by              String
  purpose                   String
  export_type               String
  requested_scope           String    @default("[]")
  formats                   String    @default("[\"JSON\"]")
  status                    String    @default("REQUESTED") // REQUESTED|VALIDATING|QUEUED|RUNNING|VERIFYING|READY|PARTIAL|FAILED|EXPIRED|CANCELLED
  authorization_decision_id String
  idempotency_key           String?
  progress                  Int       @default(0)
  failure_code              String?
  created_at                DateTime  @default(now())
  started_at                DateTime?
  completed_at              DateTime?
  expires_at                DateTime?

  artifacts ExportArtifact[]
  manifest  ExportManifest?

  @@unique([tenant_id, idempotency_key])
  @@index([tenant_id])
}

model ExportArtifact {
  id                 String    @id @default(uuid())
  tenant_id          String
  export_job_id      String
  exportJob          ExportJob @relation(fields: [export_job_id], references: [id])
  artifact_type      String
  schema_id          String
  schema_version     String
  object_count       Int       @default(0)
  content_hash       String
  media_type         String    @default("application/json")
  object_storage_ref String?
  size_bytes         Int?
  created_at         DateTime  @default(now())

  @@index([export_job_id])
}

model ExportManifest {
  id                  String    @id @default(uuid())
  tenant_id           String
  export_job_id       String    @unique
  exportJob           ExportJob @relation(fields: [export_job_id], references: [id])
  manifest_version    String    @default("1.0")
  scope               String    @default("[]")
  purpose             String
  generated_at        DateTime  @default(now())
  schema_versions     String    @default("[]")
  artifacts           String    @default("[]")
  counts              String    @default("{}")
  hashes              String    @default("{}")
  evidence_proof_refs String    @default("[]")
  audit_package_refs  String    @default("[]")
  known_limitations   String    @default("[]")
  legal_hold_state    String    @default("NONE")
  completeness_state  String    @default("UNKNOWN")
  manifest_hash       String

  @@index([tenant_id])
}

// --- shield-core-owned: legal hold / deletion / offboarding ---
model LegalHold {
  id                        String    @id @default(uuid())
  tenant_id                 String
  scope                     String    @default("{}")
  authority                 String
  reason                    String
  status                    String    @default("ACTIVE") // ACTIVE|RELEASED|EXPIRED
  starts_at                 DateTime  @default(now())
  ends_at                   DateTime?
  review_at                 DateTime
  created_by                String
  authorization_decision_id String
  created_at                DateTime  @default(now())

  @@index([tenant_id])
}

model DeletionRequest {
  id                        String    @id @default(uuid())
  tenant_id                 String
  requested_by              String
  reason                    String
  scope                     String    @default("{}")
  status                    String    @default("REQUESTED") // REQUESTED|VALIDATING|BLOCKED_BY_HOLD|APPROVED|RUNNING|RECONCILING|BACKUP_EXPIRY_PENDING|COMPLETED|FAILED
  legal_hold_state          String    @default("NONE")
  authorization_decision_id String
  created_at                DateTime  @default(now())
  approved_at               DateTime?
  started_at                DateTime?
  completed_at              DateTime?

  tasks        DeletionTask[]
  backupExpiry BackupExpiryRecord[]
  attestation  DeletionAttestation?

  @@index([tenant_id])
}

model DeletionTask {
  id                  String          @id @default(uuid())
  tenant_id           String
  deletion_request_id String
  request             DeletionRequest @relation(fields: [deletion_request_id], references: [id])
  store_type          String // POSTGRES_AUTHORITY|OBJECT_STORAGE|SEARCH|CACHE|ANALYTICS|AI_MEMORY|EMBEDDINGS|EXPORT_CACHE|CONNECTOR_STATE
  object_type         String
  scope               String          @default("{}")
  status              String          @default("PENDING") // PENDING|RUNNING|COMPLETED|FAILED
  started_at          DateTime?
  completed_at        DateTime?
  verification_result String?
  error_code          String?

  @@index([deletion_request_id])
}

model BackupExpiryRecord {
  id                       String          @id @default(uuid())
  tenant_id                String
  deletion_request_id      String
  request                  DeletionRequest @relation(fields: [deletion_request_id], references: [id])
  backup_class             String
  retained_until           DateTime
  final_expiry_expected_at DateTime
  verified_expired_at      DateTime?
  status                   String          @default("PENDING") // PENDING|EXPIRED_VERIFIED|EXCEPTION|FAILED_VERIFICATION
  created_at               DateTime        @default(now())

  @@index([deletion_request_id])
}

model DeletionAttestation {
  id                    String          @id @default(uuid())
  tenant_id             String
  deletion_request_id   String          @unique
  request               DeletionRequest @relation(fields: [deletion_request_id], references: [id])
  deleted_scopes        String          @default("[]")
  retained_scopes       String          @default("[]")
  legal_hold_refs       String          @default("[]")
  backup_expiry_refs    String          @default("[]")
  derived_store_results String          @default("[]")
  evidence_refs         String          @default("[]")
  limitations           String          @default("[]")
  attestation_hash      String
  issued_by             String
  issued_at             DateTime        @default(now())
}

model TenantOffboardingRun {
  id                        String    @id @default(uuid())
  tenant_id                 String
  requested_by              String
  reason                    String
  status                    String    @default("REQUESTED") // REQUESTED|VALIDATING|EXPORT_REQUIRED|EXPORTING|EXPORT_READY|ACCESS_FREEZE_PENDING|ACCESS_FROZEN|CONNECTOR_REVOCATION|DELETION_PENDING|DELETING|BACKUP_EXPIRY_PENDING|COMPLETED|BLOCKED|FAILED
  export_job_id             String?
  deletion_request_id       String?
  initiated_at              DateTime  @default(now())
  completed_at              DateTime?
  authorization_decision_id String

  @@index([tenant_id])
}
