  @@unique([commercial_account_id, tenant_id, environment_id])
  @@index([tenant_id, status])
  @@index([legal_entity_id])
  @@index([environment_id, region])
}

/**
 * Approved subsidiary/business-unit separation plan. Historical evidence is
 * intentionally not related through a mutable foreign key: execution closes
 * the old commercial boundary and creates future-dated target records while
 * evidence and its lineage remain under their original tenant identifiers.
 */
model CorporateTransfer {
  id                           String            @id @default(uuid())
  source_commercial_account_id String
  sourceCommercialAccount      CommercialAccount @relation("CorporateTransferSourceAccount", fields: [source_commercial_account_id], references: [id])
  source_binding_id            String
  source_tenant_id             String
  source_environment_id        String
  source_binding_updated_at    DateTime
  target_commercial_account_id String
  targetCommercialAccount      CommercialAccount @relation("CorporateTransferTargetAccount", fields: [target_commercial_account_id], references: [id])
  target_tenant_id             String
  target_environment_id        String
  target_legal_entity_id       String
  target_business_unit_id      String?
  target_region                String
  target_residency_policy      String
  target_service_scope         String            @default("[]")
  effective_at                 DateTime
  data_decision                String            @default("RETAIN_HISTORICAL_AT_SOURCE")
  export_decision              String            @default("NOT_REQUIRED")
  export_manifest_id           String?
  legal_hold_decision          String            @default("PRESERVE_IN_SOURCE")
  legal_hold_references        String            @default("[]")
  entitlement_mapping          String            @default("[]")
  evidence_lineage_policy      String            @default("PRESERVE_SOURCE_IDENTIFIERS")
  evidence_boundary_snapshot   String            @default("{}")
  source_approval_id           String?           @unique
  target_approval_id           String?           @unique
  status                       String            @default("PENDING_APPROVAL")
  requested_by                 String
  requested_at                 DateTime          @default(now())
  executed_by                  String?
  executed_at                  DateTime?
  reconciled_by                String?
  reconciled_at                DateTime?
  reconciliation_result        String            @default("{}")
  created_at                   DateTime          @default(now())
  updated_at                   DateTime          @updatedAt

  @@index([source_tenant_id, status])
  @@index([target_tenant_id, status])
  @@index([source_commercial_account_id])
  @@index([target_commercial_account_id])
  @@index([effective_at, status])
}

model Entitlement {
  id                      String                @id @default(uuid())
  commercial_account_id   String
  commercialAccount       CommercialAccount     @relation(fields: [commercial_account_id], references: [id])
  tenant_id               String
  offer_type              String
  source_type             String                @default("ACCEPTED_ORDER")
  source_id               String?
  evaluation_program_id   String?
  evaluationProgram       EvaluationProgram?    @relation(fields: [evaluation_program_id], references: [id])
  activation_amendment_id String?
  activationAmendment     CommercialAmendment?  @relation(fields: [activation_amendment_id], references: [id])
  concession_id           String?
  concession              CommercialConcession? @relation(fields: [concession_id], references: [id])
  bundle_order_line_id    String?               @unique
  bundleOrderLine         CommercialOrderLine?  @relation("BundleComponentEntitlement", fields: [bundle_order_line_id], references: [id], onDelete: Restrict)
  status                  String                @default("ACTIVE")
  effective_from          DateTime              @default(now())
  effective_to            DateTime?
  created_at              DateTime              @default(now())
  updated_at              DateTime              @updatedAt

  invoiceBases CommercialInvoiceLineBasis[]

  @@index([tenant_id])
  @@index([offer_type])
  @@index([status])
  @@index([source_type, source_id])
  @@index([evaluation_program_id, status])
  @@index([activation_amendment_id, status])
  @@index([concession_id, status])
}

/**
 * Time-bound, explicitly governed pre-production commercial access. There is
 * deliberately no generic or unlimited "trial" record: every design-partner,
 * evaluation, or pilot programme has an approval, a hard end and a fail-closed
 * entitlement expiry action.
 */
model EvaluationProgram {
  id                    String            @id @default(uuid())
  program_key           String            @unique
  program_type          String
  commercial_account_id String
  commercialAccount     CommercialAccount @relation(fields: [commercial_account_id], references: [id])
  tenant_id             String
  environment_id        String
  region                String
  starts_at             DateTime
  ends_at               DateTime
  data_classes          String            @default("[]")
  connector_scope       String            @default("[]")
  entitlement_scope     String            @default("[]")
  service_coverage      String            @default("[]")
  response_authority    String            @default("NONE")
  payment_requirement   String            @default("NOT_REQUIRED")
  payment_reference_id  String?
  conversion_policy     String            @default("EXPIRE")
  expiry_action         String            @default("REVOKE_ENTITLEMENTS")
  status                String            @default("DRAFT")
  approval_id           String?           @unique
  requested_by          String
  approved_by           String?
  approved_at           DateTime?
  activated_at          DateTime?
  expired_at            DateTime?
  converted_order_id    String?
  convertedOrder        CommercialOrder?  @relation(fields: [converted_order_id], references: [id])
  converted_at          DateTime?
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt

  entitlements Entitlement[]

  @@index([commercial_account_id, status])
  @@index([tenant_id, environment_id, status])
  @@index([starts_at, status])
  @@index([ends_at, status])
}

model ClaimRegister {
