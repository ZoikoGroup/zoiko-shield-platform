  accessEvents IncidentLegalAccessEvent[]

  @@index([tenant_id, environment_id, purpose])
  @@index([work_order_id, recorded_at])
}

/**
 * Append-only purpose/access log for every legal-sensitive record access.
 */
model IncidentLegalAccessEvent {
  id              String                       @id @default(uuid())
  tenant_id       String
  environment_id  String
  legal_record_id String
  legalRecord     IncidentLegalSensitiveRecord @relation(fields: [legal_record_id], references: [id])
  action          String
  purpose         String
  access_reason   String
  actor_id        String
  accessed_at     DateTime                     @default(now())

  @@index([tenant_id, environment_id, accessed_at])
  @@index([legal_record_id, accessed_at])
}

/**
 * Governed Category G professional-service SOW. Commercial scope is approved
 * once and copied into immutable delivery records; work evidence is never an
 * invoice by itself.
 */
model ProfessionalServiceEngagement {
  id                            String            @id @default(uuid())
  tenant_id                     String
  environment_id                String
  commercial_account_id         String
  commercialAccount             CommercialAccount @relation(fields: [commercial_account_id], references: [id])
  contract_id                   String
  contract                      Contract          @relation(fields: [contract_id], references: [id])
  service_obligation_id         String            @unique
  serviceObligation             ServiceObligation @relation(fields: [service_obligation_id], references: [id])
  engagement_key                String
  version                       Int               @default(1)
  service_type                  String
  sow_reference                 String
  price_book_id                 String
  priceBook                     PriceBook         @relation(fields: [price_book_id], references: [id])
  term_start                    DateTime
  term_end                      DateTime
  scheduled_service_at          DateTime?
  scope                         String            @default("{}")
  required_inputs               String            @default("[]")
  customer_responsibilities     String            @default("[]")
  provider_responsibilities     String            @default("[]")
  deliverable_definitions       String            @default("[]")
  acceptance_criteria           String            @default("[]")
  correction_retest_policy      String            @default("{}")
  pricing_mode                  String
  currency                      String
  contracted_amount             Decimal           @default(0) @db.Decimal(14, 4)
  allocation_period             String            @default("PROJECT")
  included_hours                Decimal           @db.Decimal(8, 2)
  hourly_rate                   Decimal?          @db.Decimal(14, 4)
  consumed_hours                Decimal           @default(0) @db.Decimal(8, 2)
  overage_hours                 Decimal           @default(0) @db.Decimal(8, 2)
  forecast_hours                Decimal           @default(0) @db.Decimal(8, 2)
  warning_threshold_percent     Int               @default(80)
  threshold_state               String            @default("WITHIN_ALLOWANCE")
  overage_policy                String            @default("REQUIRE_APPROVAL")
  overage_cap_hours             Decimal?          @db.Decimal(8, 2)
  rollover_policy               String            @default("NONE")
  rollover_cap_hours            Decimal?          @db.Decimal(8, 2)
  hours_expire_at               DateTime
  meeting_cadence               String?
  review_cadence                String?
  pen_test_authorization        String            @default("{}")
  rules_of_engagement           String            @default("{}")
  tester_assurance              String            @default("{}")
  report_treatment              String            @default("{}")
  framework_key                 String?
  framework_version             String?
  source_data_responsibilities  String            @default("{}")
  limitations                   String            @default("[]")
  status                        String            @default("PENDING_APPROVAL")
  approval_id                   String?           @unique
  requested_by                  String
  approved_by                   String?
  approved_at                   DateTime?
  activated_by                  String?
  activation_reference          String?
  readiness_evidence_refs       String            @default("[]")
  activated_at                  DateTime?
  accepted_by_customer          String?
  customer_acceptance_reference String?
  accepted_at                   DateTime?
  completed_at                  DateTime?
  created_at                    DateTime          @default(now())
  updated_at                    DateTime          @updatedAt

  activities       ProfessionalServiceActivity[]
  deliverables     ProfessionalServiceDeliverable[]
  acceptanceEvents ProfessionalServiceAcceptanceEvent[]

  @@unique([tenant_id, environment_id, engagement_key, version])
  @@index([tenant_id, environment_id, status])
  @@index([commercial_account_id, status])
  @@index([contract_id, status])
  @@index([service_type, status])
  @@index([term_start, term_end, status])
}

/**
 * Append-only work and hour evidence, including the applicable hour period.
 */
model ProfessionalServiceActivity {
  id                       String                        @id @default(uuid())
  tenant_id                String
  environment_id           String
  engagement_id            String
  engagement               ProfessionalServiceEngagement @relation(fields: [engagement_id], references: [id])
  activity_type            String
  entry_type               String                        @default("STANDARD")
  hours                    Decimal                       @db.Decimal(8, 2)
  allocation_period_start  DateTime
  allocation_period_end    DateTime
  included_available_after Decimal                       @db.Decimal(8, 2)
  consumed_period_after    Decimal                       @db.Decimal(8, 2)
  overage_period_after     Decimal                       @db.Decimal(8, 2)
  forecast_period_after    Decimal                       @db.Decimal(8, 2)
  total_engagement_after   Decimal                       @db.Decimal(8, 2)
  threshold_state          String
  overage_approval_id      String?
  summary                  String
  evidence_reference       String
  actor_id                 String
  occurred_at              DateTime
  created_at               DateTime                      @default(now())

  @@index([tenant_id, environment_id, occurred_at])
  @@index([engagement_id, allocation_period_start, occurred_at])
  @@index([entry_type])
}

/**
 * Immutable deliverable submission; corrections create a new version.
 */
model ProfessionalServiceDeliverable {
  id                  String                           @id @default(uuid())
  tenant_id           String
  environment_id      String
  engagement_id       String
  engagement          ProfessionalServiceEngagement    @relation(fields: [engagement_id], references: [id])
  deliverable_key     String
  version             Int
  title               String
  content_reference   String
  evidence_references String                           @default("[]")
  limitations         String                           @default("[]")
  correction_of_id    String?
  correctionOf        ProfessionalServiceDeliverable?  @relation("ProfessionalServiceDeliverableCorrection", fields: [correction_of_id], references: [id])
  corrections         ProfessionalServiceDeliverable[] @relation("ProfessionalServiceDeliverableCorrection")
  retest_reference    String?
  submitted_by        String
  submitted_at        DateTime                         @default(now())

  @@unique([engagement_id, deliverable_key, version])
  @@index([tenant_id, environment_id, submitted_at])
  @@index([engagement_id, submitted_at])
  @@index([correction_of_id])
}

/**
 * Append-only customer acceptance or correction/retest decision.
 */
model ProfessionalServiceAcceptanceEvent {
  id                          String                        @id @default(uuid())
  tenant_id                   String
  environment_id              String
  engagement_id               String
  engagement                  ProfessionalServiceEngagement @relation(fields: [engagement_id], references: [id])
  round                       Int
  decision                    String
  reviewed_deliverable_ids    String                        @default("[]")
  criteria_results            String                        @default("{}")
  named_customer_authorizer   String
  customer_decision_reference String
  correction_scope            String?
  retest_required             Boolean                       @default(false)
  decided_by                  String
  decided_at                  DateTime                      @default(now())

  @@unique([engagement_id, round])
  @@index([tenant_id, environment_id, decided_at])
  @@index([engagement_id, decided_at])
  @@index([decision])
}

// ============================================================
// ZS-COM-BILL-001 P1 Part 21: Partner/Reseller/MSP domain. Operational
// access (delegation) never implies commercial authority — pricing is
// never mutable through a delegation regardless of scope, and
// entitlement always derives from the accepted order, never the partner
// relationship directly.
// ============================================================

model Partner {
  id                       String   @id @default(uuid())
  legal_name               String
  partner_type             String
  managing_organization_id String   @unique
  status                   String   @default("ACTIVE")
  created_at               DateTime @default(now())

  delegations       PartnerDelegation[]
  principalContexts PartnerPrincipalContext[]

  @@index([status])
}

/**
 * Authoritative identity-to-managing-organization binding. A principal can
 * operate for only one partner organization and cannot become delegated merely
 * because a customer grant contains a matching free-form identifier.
 */
model PartnerPrincipalContext {
  id                       String    @id @default(uuid())
  partner_id               String
  partner                  Partner   @relation(fields: [partner_id], references: [id])
  principal_id             String    @unique
  managing_organization_id String
  status                   String    @default("ACTIVE")
  created_by               String
  deactivated_by           String?
  deactivated_at           DateTime?
  deactivation_reason      String?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  delegations PartnerDelegation[]

  @@index([partner_id, status])
  @@index([managing_organization_id, status])
}

model PartnerAgreement {
  id                     String    @id @default(uuid())
  partner_id             String
  commission_percent     Decimal   @default(0) @db.Decimal(5, 2)
  margin_percent         Decimal   @default(0) @db.Decimal(5, 2)
  invoice_responsibility String    @default("ZOIKOSHIELD")
  tax_responsibility     String    @default("ZOIKOSHIELD")
  support_responsibility String    @default("ZOIKOSHIELD")
  renewal_rights         String    @default("ZOIKOSHIELD")
  status                 String    @default("DRAFT")
  approved_by            String?
  approved_at            DateTime?
  effective_from         DateTime  @default(now())
  effective_to           DateTime?
  created_at             DateTime  @default(now())

  @@index([partner_id])
  @@index([status])
}

/**
 * Explicit, tenant-scoped, revocable, expiring, non-transitive. Never grants pricing authority.
 */
model PartnerDelegation {
  id                           String                   @id @default(uuid())
  partner_id                   String
  partner                      Partner                  @relation(fields: [partner_id], references: [id])
  managing_organization_id     String
  partner_principal_id         String
  partner_principal_context_id String?
  partnerPrincipalContext      PartnerPrincipalContext? @relation(fields: [partner_principal_context_id], references: [id])
  commercial_account_id        String
  tenant_id                    String
  environment_id               String
  scope                        String                   @default("[]")
  customer_visible             Boolean                  @default(true)
  status                       String                   @default("ACTIVE")
  granted_by                   String
  expires_at                   DateTime
  revoked_by                   String?
  revocation_reason            String?
  revoked_at                   DateTime?
  created_at                   DateTime                 @default(now())
  updated_at                   DateTime                 @updatedAt

  supportCases PartnerSupportCase[]

  @@index([partner_id])
  @@index([commercial_account_id, tenant_id, environment_id])
  @@index([tenant_id, status])
  @@index([partner_principal_id, tenant_id, status])
  @@index([partner_principal_context_id, status])
  @@index([managing_organization_id, status])
  @@index([status])
}

/**
 * Customer-bound support workflow available to delegated partner operators.
 * It is intentionally separate from security Case/Incident records and has no
 * commercial price, payment, entitlement-mutation or response authority.
 */
model PartnerSupportCase {
  id                        String             @id @default(uuid())
  commercial_account_id     String
  commercialAccount         CommercialAccount  @relation(fields: [commercial_account_id], references: [id])
  tenant_id                 String
  environment_id            String
  subject                   String
  description               String
  priority                  String             @default("NORMAL")
  status                    String             @default("OPEN")
  created_by                String
  updated_by                String?
  created_via_delegation_id String?
  createdViaDelegation      PartnerDelegation? @relation(fields: [created_via_delegation_id], references: [id])
  created_at                DateTime           @default(now())
  updated_at                DateTime           @updatedAt

  @@index([commercial_account_id, tenant_id, environment_id])
  @@index([tenant_id, status])
  @@index([created_via_delegation_id])
}

model PartnerSettlement {
  id                String   @id @default(uuid())
  partner_id        String
  period_start      DateTime
  period_end        DateTime
  gross_amount      Decimal  @db.Decimal(14, 4)
  commission_amount Decimal  @db.Decimal(14, 4)
  currency          String   @default("USD")
  status            String   @default("DRAFT")
  created_at        DateTime @default(now())

  @@index([partner_id])
  @@index([status])
}

// ============================================================
// ZS-COM-BILL-001 P1 Part 23 / REG-01: sector & framework packs. A pack is
// a support capability, never an automatic certification claim.
// Unsupported region/pack combinations fail closed.
// ============================================================

model SectorPack {
  id                       String    @id @default(uuid())
  pack_key                 String
  version                  Int       @default(1)
  jurisdiction             String
  source_reference         String?
  source_version           String?
  content_license_status   String    @default("PENDING")
  license_reference        String?
  display_rights           Boolean   @default(false)
  legal_interpretation_ref String?
  sme_review_ref           String?
  mapping_test_status      String    @default("NOT_RUN")
  mapping_test_report_ref  String?
  required_connectors      String    @default("[]")
  approved_claim_wording   String?
  release_status           String    @default("DRAFT")
  approval_id              String?   @unique
  requested_by             String?
  approved_by              String?
  approved_at              DateTime?
  effective_from           DateTime  @default(now())
  effective_to             DateTime?
  created_at               DateTime  @default(now())

  marketAvailability MarketAvailability[]

  @@unique([pack_key, version])
  @@index([release_status])
}

model MarketAvailability {
  id             String     @id @default(uuid())
  sector_pack_id String
  sectorPack     SectorPack @relation(fields: [sector_pack_id], references: [id])
  region         String
  available      Boolean    @default(false)
  created_at     DateTime   @default(now())

  @@unique([sector_pack_id, region])
  @@index([region])
}

// ============================================================
// ZS-COM-BILL-001 P1 Part 12 / AI-01: internal AI cost != customer
// billable usage. Every AI action is logged with its true internal cost;
// it becomes customer-billable only through the same accepted-vs-billable
// MeteringService pipeline used everywhere else, gated on an explicit
// customer authorization (active AI_SECURITY entitlement).
// ============================================================

model AiUsageRecord {
  id                             String               @id @default(uuid())
  tenant_id                      String
  environment_id                 String               @default("UNBOUND")
  governance_profile_id          String?
  governanceProfile              AiGovernanceProfile? @relation(fields: [governance_profile_id], references: [id])
  use_case_key                   String               @default("LEGACY_UNBOUND")
  workflow                       String
  workflow_class                 String               @default("STANDARD")
  provider                       String
  model                          String
  model_profile_id               String?
  model_class                    String               @default("STANDARD")
  input_tokens                   Int                  @default(0)
  output_tokens                  Int                  @default(0)
  tool_calls                     Int                  @default(0)
  retrieval_calls                Int                  @default(0)
  retrieval_units                Int                  @default(0)
  ai_storage_byte_hours          Decimal              @default(0) @db.Decimal(20, 4)
  contracted_usage_units         Decimal              @default(0) @db.Decimal(14, 4)
  complexity_units               Decimal              @default(0) @db.Decimal(14, 4)
  internal_cost                  Decimal              @default(0) @db.Decimal(14, 6)
  internal_cost_source           String               @default("CALLER_REPORTED")
  provider_price_version         String?
  fallback_used                  Boolean              @default(false)
  fallback_from_model_profile_id String?
  billing_classification         String               @default("INTERNAL_COST_ONLY")
  billable                       Boolean              @default(false)
  billable_quantity              Decimal              @default(0) @db.Decimal(14, 4)
  meter_event_id                 String?
  catalog_version_id             String?
  customer_authorization_ref     String?
