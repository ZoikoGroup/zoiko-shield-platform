  @@unique([tenant_id, environment_id, profile_key, version])
  @@index([tenant_id, environment_id, status])
  @@index([commercial_account_id, status])
  @@index([contract_id, status])
  @@index([effective_from, effective_to, status])
}

model CommercialInvoice {
  id                    String            @id @default(uuid())
  commercial_account_id String
  commercialAccount     CommercialAccount @relation(fields: [commercial_account_id], references: [id])
  contract_id           String
  contract              Contract          @relation(fields: [contract_id], references: [id])
  status                String            @default("DRAFT")
  currency              String            @default("USD")
  total_amount          Float             @default(0.0)
  issued_at             DateTime?
  immutable_snapshot    String            @default("{}")
  // Part 10/11: FX + tax result are captured at issue time and never
  // rewritten afterward — original legal invoice values stay frozen.
  fx_rate               Decimal?          @db.Decimal(18, 8)
  fx_source             String?
  fx_effective_at       DateTime?
  tax_result            String            @default("{}")
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt

  lines       CommercialInvoiceLine[]
  traces      CommercialInvoiceLineTrace[]
  creditNotes CommercialCreditNote[]
  debitNotes  CommercialDebitNote[]
  payments    Payment[]

  @@index([commercial_account_id])
  @@index([contract_id])
  @@index([status])
}

model CommercialInvoiceLine {
  id                   String               @id @default(uuid())
  invoice_id           String
  invoice              CommercialInvoice    @relation(fields: [invoice_id], references: [id])
  order_line_id        String?
  orderLine            CommercialOrderLine? @relation(fields: [order_line_id], references: [id], onDelete: Restrict)
  price_book_id        String?
  priceBook            PriceBook?           @relation(fields: [price_book_id], references: [id], onDelete: Restrict)
  sku                  String
  contract_id          String
  subscription_id      String?
  service_period_start DateTime
  service_period_end   DateTime
  quantity             Int                  @default(1)
  unit_price           Decimal              @db.Decimal(14, 4)
  discount_percent     Decimal              @default(0) @db.Decimal(5, 2)
  tax_amount           Decimal              @default(0) @db.Decimal(14, 4)
  tax_rule_id          String?
  currency             String               @default("USD")
  source_version       String               @default("v1")
  presentation_mode    String               @default("SEPARATE")
  representation_scope String               @default("COMMERCIAL_ENTITLEMENT_OR_OBLIGATION")
  created_at           DateTime             @default(now())

  traces CommercialInvoiceLineTrace[]
  bases  CommercialInvoiceLineBasis[]

  @@index([invoice_id])
  @@index([order_line_id])
  @@index([price_book_id])
}

/**
 * Frozen commercial/service evidence explaining what an invoice line bills.
 * Outcome evidence remains in its source domain; this row records the exact
 * entitlement, obligation or approved meter snapshot observed at billing time.
 */
model CommercialInvoiceLineBasis {
  id                            String                    @id @default(uuid())
  invoice_line_id               String
  invoiceLine                   CommercialInvoiceLine     @relation(fields: [invoice_line_id], references: [id], onDelete: Restrict)
  basis_type                    String
  source_id                     String
  entitlement_id                String?
  entitlement                   Entitlement?              @relation(fields: [entitlement_id], references: [id], onDelete: Restrict)
  service_obligation_id         String?
  serviceObligation             ServiceObligation?        @relation(fields: [service_obligation_id], references: [id], onDelete: Restrict)
  meter_billing_export_id       String?
  meterBillingExport            MeterBillingExport?       @relation(fields: [meter_billing_export_id], references: [id], onDelete: Restrict)
  meter_authorization_policy_id String?
  meterAuthorizationPolicy      MeterAuthorizationPolicy? @relation(fields: [meter_authorization_policy_id], references: [id], onDelete: Restrict)
  source_status                 String
  source_version                String                    @default("v1")
  quantity                      Int                       @default(1)
  unit                          String
  service_period_start          DateTime
  service_period_end            DateTime
  source_snapshot               String
  source_snapshot_hash          String
  created_at                    DateTime                  @default(now())

  @@unique([invoice_line_id, basis_type, source_id])
  @@index([entitlement_id])
  @@index([service_obligation_id])
  @@index([meter_billing_export_id])
  @@index([meter_authorization_policy_id])
}

/**
 * A normalized source edge for invoice presentation. An invoice may show one
 * bundle line, but every underlying technology/service component and its
 * allocated pre-tax amount remains queryable and independently reconcilable.
 */
model CommercialInvoiceLineTrace {
  id                   String                @id @default(uuid())
  invoice_id           String
  invoice              CommercialInvoice     @relation(fields: [invoice_id], references: [id], onDelete: Restrict)
  invoice_line_id      String
  invoiceLine          CommercialInvoiceLine @relation(fields: [invoice_line_id], references: [id], onDelete: Restrict)
  order_line_id        String
  orderLine            CommercialOrderLine   @relation(fields: [order_line_id], references: [id], onDelete: Restrict)
  allocated_amount     Decimal               @db.Decimal(14, 4)
  currency             String
  service_period_start DateTime
  service_period_end   DateTime
  created_at           DateTime              @default(now())

  @@unique([invoice_id, order_line_id, service_period_start, service_period_end])
  @@index([invoice_line_id])
  @@index([order_line_id])
}

/**
 * Part 12: corrections to an issued invoice are append-only, never edits.
 */
model CommercialCreditNote {
  id         String            @id @default(uuid())
  invoice_id String
  invoice    CommercialInvoice @relation(fields: [invoice_id], references: [id])
  amount     Decimal           @db.Decimal(14, 4)
  currency   String            @default("USD")
  reason     String
  status     String            @default("DRAFT")
  issued_at  DateTime?
  created_at DateTime          @default(now())

  @@index([invoice_id])
}

model CommercialDebitNote {
  id         String            @id @default(uuid())
  invoice_id String
  invoice    CommercialInvoice @relation(fields: [invoice_id], references: [id])
  amount     Decimal           @db.Decimal(14, 4)
  currency   String            @default("USD")
  reason     String
  status     String            @default("DRAFT")
  issued_at  DateTime?
  created_at DateTime          @default(now())

  @@index([invoice_id])
}

/**
 * Part 10: fail-closed tax resolution — never a hardcoded global rate.
 */
model TaxRule {
  id                String    @id @default(uuid())
  jurisdiction      String
  product_tax_class String
  rate_percent      Decimal   @db.Decimal(6, 4)
  reverse_charge    Boolean   @default(false)
  status            String    @default("DRAFT")
  effective_from    DateTime  @default(now())
  effective_to      DateTime?
  approved_by       String?
  approved_at       DateTime?
  created_at        DateTime  @default(now())

  @@index([jurisdiction, product_tax_class])
  @@index([status])
}

// ============================================================
// ZS-COM-BILL-001 P0.3 Part 9: payment domain. No raw PAN/CVC is ever
// stored — payment_method_reference holds only a provider-issued token.
// ============================================================

model PaymentMethodReference {
  id                    String             @id @default(uuid())
  commercial_account_id String
  commercialAccount     CommercialAccount  @relation("CommercialAccountPaymentMethods", fields: [commercial_account_id], references: [id])
  defaultForAccount     CommercialAccount? @relation("CommercialAccountDefaultPaymentMethod")
  provider              String
  provider_token        String
  brand                 String?
  last4                 String?
  status                String             @default("ACTIVE")
  created_at            DateTime           @default(now())
  updated_at            DateTime           @updatedAt

  @@unique([provider, provider_token])
  @@index([commercial_account_id, status])
}

model Payment {
  id                          String            @id @default(uuid())
  commercial_account_id       String
  invoice_id                  String
  invoice                     CommercialInvoice @relation(fields: [invoice_id], references: [id])
  provider                    String
  provider_payment_id         String?
  payment_method_reference_id String?
  amount                      Decimal           @db.Decimal(14, 4)
  currency                    String            @default("USD")
  status                      String            @default("PENDING")
  idempotency_key             String            @unique
  created_at                  DateTime          @default(now())
  updated_at                  DateTime          @updatedAt

  refunds Refund[]

  @@index([commercial_account_id])
  @@index([invoice_id])
  @@index([status])
}

model Refund {
  id         String   @id @default(uuid())
  payment_id String
  payment    Payment  @relation(fields: [payment_id], references: [id])
  amount     Decimal  @db.Decimal(14, 4)
  currency   String   @default("USD")
  reason     String
  status     String   @default("PENDING")
  created_at DateTime @default(now())

  @@index([payment_id])
}

model CommercialEvent {
  id              String    @id @default(uuid())
  event_type      String
  tenant_id       String?
  actor           String?
  payload         String
  idempotency_key String    @unique
  created_at      DateTime  @default(now())
  published_at    DateTime?

  @@index([idempotency_key])
  @@index([event_type])
}

// ============================================================
// ZS-COM-BILL-001 P0.1: CPQ chain (Quote -> Order -> Subscription),
// maker-checker commercial approvals, and a reusable idempotency ledger.
// ============================================================

model CommercialQuote {
  id                    String            @id @default(uuid())
  tenant_id             String
  environment_id        String
  commercial_account_id String
  commercialAccount     CommercialAccount @relation(fields: [commercial_account_id], references: [id])
  catalog_version_id    String
  catalogVersion        CatalogVersion    @relation(fields: [catalog_version_id], references: [id])
  status                String            @default("DRAFT")
  quote_key             String
  version               Int               @default(1)
  supersedes_quote_id   String?           @unique
  supersedesQuote       CommercialQuote?  @relation("CommercialQuoteRevision", fields: [supersedes_quote_id], references: [id], onDelete: Restrict)
  revisions             CommercialQuote[] @relation("CommercialQuoteRevision")
  currency              String            @default("USD")
  region                String            @default("GLOBAL")
  term_months           Int               @default(12)
  requires_approval     Boolean           @default(false)
  approval_id           String?
  snapshot              String            @default("{}")
  configuration_hash    String
  validation_status     String            @default("PENDING_VALIDATION")
  requested_by          String
  approved_by           String?
  approved_at           DateTime?
  rejected_reason       String?
  expires_at            DateTime?
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt

  lines              CommercialQuoteLine[]
  orders             CommercialOrder[]
  validation         CommercialQuoteValidation?
  roadmapCommitments RoadmapCommitment[]
  discountReview     QuoteDiscountReview?

  @@unique([commercial_account_id, quote_key, version])
  @@index([commercial_account_id])
  @@index([tenant_id, environment_id, status])
  @@index([status])
}

/**
 * Versioned, platform-approved escalation thresholds for one service class.
 * Sales cannot create or approve these policies. Quotes consume only a policy
 * that is APPROVED and effective for their region/currency.
 */
model DiscountAuthorityPolicy {
  id                            String                    @id @default(uuid())
  policy_key                    String
  version                       Int                       @default(1)
  supersedes_policy_id          String?                   @unique
  supersedesPolicy              DiscountAuthorityPolicy?  @relation("DiscountAuthorityPolicyRevision", fields: [supersedes_policy_id], references: [id], onDelete: Restrict)
  revisions                     DiscountAuthorityPolicy[] @relation("DiscountAuthorityPolicyRevision")
  service_class                 String
  region                        String
  currency                      String
  standard_margin_floor_percent Decimal                   @db.Decimal(6, 2)
  finance_margin_floor_percent  Decimal                   @db.Decimal(6, 2)
  absolute_margin_floor_percent Decimal                   @db.Decimal(6, 2)
  status                        String                    @default("PENDING_APPROVAL")
  effective_from                DateTime
  effective_to                  DateTime?
  requested_by                  String
  requested_at                  DateTime                  @default(now())
  decided_by                    String?
  decided_at                    DateTime?
  decision_reason               String?
  created_at                    DateTime                  @default(now())

  @@unique([policy_key, version])
  @@index([service_class, region, currency, status, effective_from])
  @@index([status, effective_from])
}

/**
 * Frozen I3 economics and authority decision for a discounted quote. This is
 * separate from the CPQ technical-readiness receipt: a commercial approver can
 * accept/reject economics but cannot edit technical authority or scope.
 */
model QuoteDiscountReview {
  id                            String              @id @default(uuid())
  quote_id                      String              @unique
  quote                         CommercialQuote     @relation(fields: [quote_id], references: [id], onDelete: Restrict)
  tenant_id                     String
  environment_id                String
  status                        String              @default("DRAFT")
  policy_ids                    String              @default("[]")
  gross_margin_by_service_class String              @default("[]")
  partner_pass_through          String              @default("{}")
  commercial_reason             String
  term_months                   Int
  ramp_schedule                 String              @default("[]")
  minimum_commit_amount         Decimal             @db.Decimal(14, 4)
  catalog_minimum_commit_amount Decimal             @db.Decimal(14, 4)
  discount_expires_at           DateTime
  required_approval_role        String
  authority_rank                Int
  financial_impact              Decimal             @db.Decimal(14, 4)
  margin_impact                 Decimal             @db.Decimal(8, 4)
  technical_authority_hash      String
  approval_id                   String?             @unique
  approval                      CommercialApproval? @relation("QuoteDiscountApproval", fields: [approval_id], references: [id], onDelete: Restrict)
  requested_by                  String
  submitted_at                  DateTime?
  approved_by                   String?
  approved_at                   DateTime?
  rejected_reason               String?
  created_at                    DateTime            @default(now())
  updated_at                    DateTime            @updatedAt

  @@index([tenant_id, environment_id, status])
  @@index([required_approval_role, status])
  @@index([discount_expires_at, status])
}

/**
 * Platform-verified, versioned offer readiness. Sales/CPQ can consume this
 * evidence but cannot create it or reinterpret an unavailable offer as ready.
 */
model CpqOfferReadiness {
  id                         String         @id @default(uuid())
  catalog_version_id         String
  catalogVersion             CatalogVersion @relation(fields: [catalog_version_id], references: [id], onDelete: Restrict)
  product_id                 String
  product                    Product        @relation(fields: [product_id], references: [id], onDelete: Restrict)
  region                     String
  version                    Int            @default(1)
  retention_profiles         String         @default("[]")
  service_tiers              String         @default("[]")
  supported_connector_keys   String         @default("[]")
  obligation_types           String         @default("[]")
  service_capacity_status    String
  market_availability_status String
  claim_eligibility_status   String
  evidence_refs              String         @default("[]")
  status                     String         @default("VERIFIED")
  verified_by                String
  effective_from             DateTime       @default(now())
  effective_to               DateTime?
  created_at                 DateTime       @default(now())

  @@unique([product_id, region, version])
  @@index([catalog_version_id, region, status])
  @@index([product_id, region, status, effective_from])
}

/**
 * Immutable proof of the exact checks and controlled inputs used by CPQ.
 */
model CommercialQuoteValidation {
  id                         String          @id @default(uuid())
  tenant_id                  String
  environment_id             String
  quote_id                   String          @unique
  quote                      CommercialQuote @relation(fields: [quote_id], references: [id], onDelete: Restrict)
  configuration_hash         String
  readiness_record_ids       String          @default("[]")
  price_book_ids             String          @default("[]")
  tax_rule_id                String
  dependency_status          String
  incompatibility_status     String
  unit_economics_status      String
  service_capacity_status    String
  market_availability_status String
  claim_eligibility_status   String
  partner_economics_status   String
  result                     String
  validated_by               String
  created_at                 DateTime        @default(now())

  @@index([tenant_id, environment_id, created_at])
  @@index([result, created_at])
}

/**
 * Conditional, non-GA language attached to a quote but deliberately excluded
 * from quote lines and entitlement derivation. Legal and Product approve it
 * independently; even a passed release gate only makes it eligible for a
 * separate future order.
 */
model RoadmapCommitment {
  id                            String              @id @default(uuid())
  tenant_id                     String
  environment_id                String
  quote_id                      String
  quote                         CommercialQuote     @relation(fields: [quote_id], references: [id], onDelete: Restrict)
  commitment_key                String
  target_product_id             String
  targetProduct                 Product             @relation(fields: [target_product_id], references: [id], onDelete: Restrict)
  target_catalog_version_id     String
  targetCatalogVersion          CatalogVersion      @relation(fields: [target_catalog_version_id], references: [id], onDelete: Restrict)
  feature_key                   String
  non_ga_language               String
  conditions                    String              @default("[]")
  delivery_dependency_type      String
  delivery_dependency_reference String
  target_delivery_date          DateTime?
  status                        String              @default("DRAFT")
  entitlement_effect            String              @default("NONE")
  runtime_access_status         String              @default("DISABLED")
  legal_approval_id             String?             @unique
  legalApproval                 CommercialApproval? @relation("RoadmapLegalApproval", fields: [legal_approval_id], references: [id], onDelete: Restrict)
  product_approval_id           String?             @unique
  productApproval               CommercialApproval? @relation("RoadmapProductApproval", fields: [product_approval_id], references: [id], onDelete: Restrict)
  submitted_by                  String?
  submitted_at                  DateTime?
  legal_approved_by             String?
  legal_approved_at             DateTime?
  product_approved_by           String?
  product_approved_at           DateTime?
  release_gate_evidence_refs    String              @default("[]")
  release_gate_passed_by        String?
  release_gate_passed_at        DateTime?
  created_by                    String
  created_at                    DateTime            @default(now())
  updated_at                    DateTime            @updatedAt

  @@unique([quote_id, commitment_key])
  @@unique([quote_id, feature_key])
  @@index([tenant_id, environment_id, status])
  @@index([target_product_id, status])
  @@index([quote_id, status])
}

model CommercialQuoteLine {
  id                    String          @id @default(uuid())
  quote_id              String
  quote                 CommercialQuote @relation(fields: [quote_id], references: [id])
  product_id            String
  price_book_id         String
  quantity              Int             @default(1)
  unit_price            Decimal         @db.Decimal(14, 4)
  line_discount_percent Decimal         @default(0) @db.Decimal(5, 2)
  created_at            DateTime        @default(now())

  @@index([quote_id])
}

model CommercialOrder {
  id                    String          @id @default(uuid())
  quote_id              String
  quote                 CommercialQuote @relation(fields: [quote_id], references: [id])
  commercial_account_id String
  status                String          @default("CREATED")
  contract_id           String?         @unique
  idempotency_key       String          @unique
  created_by            String
  // Set once this order backs a provisioned tenant (spec §7.2: PROVISIONING
  // requires an approved order/entitlement). Unique so an order can never be
  // claimed by more than one tenant.
  tenant_id             String?         @unique
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt

  lines                       CommercialOrderLine[]
  convertedEvaluationPrograms EvaluationProgram[]

  @@index([commercial_account_id])
  @@index([status])
}

model CommercialOrderLine {
  id                       String          @id @default(uuid())
  order_id                 String
  order                    CommercialOrder @relation(fields: [order_id], references: [id])
  product_id               String
  product                  Product         @relation("CommercialOrderLineProduct", fields: [product_id], references: [id], onDelete: Restrict)
  quantity                 Int             @default(1)
  list_unit_price          Decimal         @default(0) @db.Decimal(14, 4)
  discount_percent         Decimal         @default(0) @db.Decimal(5, 2)
  unit_price               Decimal         @db.Decimal(14, 4)
  currency                 String          @default("USD")
  line_type                String          @default("CUSTOMER")
  billable                 Boolean         @default(true)
  catalog_sku              String          @default("")
  bundle_parent_product_id String?
  bundleParentProduct      Product?        @relation("CommercialOrderLineBundleParentProduct", fields: [bundle_parent_product_id], references: [id], onDelete: Restrict)
  component_type           String?
  entitlement_offer_type   String?
  meter_definition_id      String?
  service_obligation_type  String?
  cost_class               String?
  cost_allocation_percent  Decimal?        @db.Decimal(5, 2)
  claim_key                String?
  claim_register_id        String?
  invoice_presentation     String          @default("SEPARATE")
  component_snapshot       String          @default("{}")
  component_snapshot_hash  String?
  projection_status        String          @default("NOT_APPLICABLE")
  created_at               DateTime        @default(now())

  bundleEntitlement       Entitlement?                 @relation("BundleComponentEntitlement")
  bundleServiceObligation ServiceObligation?           @relation("BundleComponentServiceObligation")
  bundleMeterProjection   BundleMeterProjection?
  bundleCostAllocation    BundleCostAllocation?
  bundleClaimEligibility  BundleClaimEligibility?
  invoiceTraces           CommercialInvoiceLineTrace[]
  invoiceLines            CommercialInvoiceLine[]

  @@index([order_id])
  @@index([order_id, line_type])
  @@index([bundle_parent_product_id])
  @@index([projection_status])
}

model CommercialSubscription {
  id                    String    @id @default(uuid())
  order_id              String    @unique
  commercial_account_id String
  contract_id           String
  status                String    @default("PENDING")
  effective_from        DateTime?
  effective_to          DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  amendments               CommercialAmendment[]
  concessions              CommercialConcession[]
  bundleMeterProjections   BundleMeterProjection[]
  bundleCostAllocations    BundleCostAllocation[]
  bundleClaimEligibilities BundleClaimEligibility[]

  @@index([commercial_account_id])
  @@index([status])
}

/**
 * Meter requirements created from an accepted bundle stay non-billable until
 * ordinary meter governance creates and approves a contract authorization.
 */
model BundleMeterProjection {
  id                     String                    @id @default(uuid())
  order_line_id          String                    @unique
  orderLine              CommercialOrderLine       @relation(fields: [order_line_id], references: [id], onDelete: Restrict)
  contract_id            String
  contract               Contract                  @relation(fields: [contract_id], references: [id], onDelete: Restrict)
  subscription_id        String
  subscription           CommercialSubscription    @relation(fields: [subscription_id], references: [id], onDelete: Restrict)
  tenant_id              String
  environment_id         String
  meter_definition_id    String
  meterDefinition        MeterDefinition           @relation(fields: [meter_definition_id], references: [id], onDelete: Restrict)
  meter_authorization_id String?                   @unique
  meterAuthorization     MeterAuthorizationPolicy? @relation("BundleMeterAuthorization", fields: [meter_authorization_id], references: [id], onDelete: Restrict)
  status                 String                    @default("PENDING_GOVERNANCE")
  created_at             DateTime                  @default(now())
  updated_at             DateTime                  @updatedAt

  @@index([contract_id, status])
  @@index([tenant_id, environment_id, status])
}

/**
 * Internal revenue/cost-basis allocation; never a separately billable line.
 */
model BundleCostAllocation {
  id                 String                 @id @default(uuid())
  order_line_id      String                 @unique
  orderLine          CommercialOrderLine    @relation(fields: [order_line_id], references: [id], onDelete: Restrict)
  contract_id        String
  contract           Contract               @relation(fields: [contract_id], references: [id], onDelete: Restrict)
  subscription_id    String
  subscription       CommercialSubscription @relation(fields: [subscription_id], references: [id], onDelete: Restrict)
  cost_class         String
  allocation_method  String                 @default("CATALOG_PERCENT")
  allocation_percent Decimal                @db.Decimal(5, 2)
  allocated_revenue  Decimal                @db.Decimal(14, 4)
  currency           String
  status             String                 @default("ALLOCATED")
  created_at         DateTime               @default(now())

  @@index([contract_id, cost_class])
  @@index([subscription_id])
}

/**
 * A bundle claim requirement is deliberately fail-closed until the existing
 * claim policy engine records a current eligibility decision for the context.
 */
model BundleClaimEligibility {
  id                       String                 @id @default(uuid())
  order_line_id            String                 @unique
  orderLine                CommercialOrderLine    @relation(fields: [order_line_id], references: [id], onDelete: Restrict)
  contract_id              String
  contract                 Contract               @relation(fields: [contract_id], references: [id], onDelete: Restrict)
  subscription_id          String
  subscription             CommercialSubscription @relation(fields: [subscription_id], references: [id], onDelete: Restrict)
  tenant_id                String
  environment_id           String
  region                   String
  claim_key                String
  claim_register_id        String
  claimRegister            ClaimRegister          @relation(fields: [claim_register_id], references: [id], onDelete: Restrict)
  channel                  String                 @default("CONTRACT")
  status                   String                 @default("PENDING_EVALUATION")
  reason_code              String                 @default("BUNDLE_COMPONENT_PENDING_EVALUATION")
  evaluated_eligibility_id String?
  evaluatedEligibility     ClaimEligibility?      @relation(fields: [evaluated_eligibility_id], references: [id], onDelete: Restrict)
  created_at               DateTime               @default(now())
  updated_at               DateTime               @updatedAt

  @@index([tenant_id, environment_id, claim_key])
  @@index([contract_id, status])
}

model CommercialAmendment {
  id                     String                 @id @default(uuid())
  subscription_id        String
  subscription           CommercialSubscription @relation(fields: [subscription_id], references: [id])
  amendment_type         String
  status                 String                 @default("REQUESTED")
  tenant_id              String?
  environment_id         String?
  approval_id            String?                @unique
  effective_at           DateTime?
  before_snapshot        String                 @default("{}")
  proposed_snapshot      String                 @default("{}")
  requested_by           String
  approved_by            String?
  claim_eligibility      Boolean                @default(false)
  deployment_ready       Boolean                @default(false)
  service_capacity_ready Boolean                @default(false)
  readiness_snapshot     String                 @default("{}")
  readiness_verified_by  String?
  readiness_verified_at  DateTime?
  assessment_snapshot    String                 @default("{}")
  remediation_plan       String                 @default("{}")
  remediation_status     String                 @default("NOT_REQUIRED")
  applied_by             String?
  applied_at             DateTime?
  created_at             DateTime               @default(now())
  updated_at             DateTime               @updatedAt

  activatedEntitlements Entitlement[]
  retentionTransition   EvidenceRetentionTransition?

  @@index([subscription_id])
  @@index([tenant_id, environment_id, status])
  @@index([effective_at, status])
  @@index([status])
}

/**
 * Prospective retention change. Existing evidence retains its original
 * profile and the hold/audit-cycle preservation basis is snapshotted here.
 */
model EvidenceRetentionTransition {
  id                           String              @id @default(uuid())
  tenant_id                    String
  environment_id               String
  amendment_id                 String              @unique
  amendment                    CommercialAmendment @relation(fields: [amendment_id], references: [id])
  target_retention_profile     String
  effective_at                 DateTime
  historical_cutoff            DateTime
  historical_evidence_count    Int                 @default(0)
  preserved_retention_profiles String              @default("[]")
  legal_hold_ids               String              @default("[]")
  audit_package_ids            String              @default("[]")
  preservation_basis           String              @default("{}")
  preserve_historical_evidence Boolean             @default(true)
  status                       String              @default("PENDING_VERIFICATION")
  evidence_refs                String              @default("[]")
  verified_by                  String?
  verified_at                  DateTime?
  applied_at                   DateTime?
  created_at                   DateTime            @default(now())
  updated_at                   DateTime            @updatedAt

  @@index([tenant_id, environment_id, status])
  @@index([effective_at, status])
}

/**
 * Approved, bounded commercial exception. A concession can activate free
 * module entitlements, but can never omit its end or renewal treatment.
 */
model CommercialConcession {
  id                    String                 @id @default(uuid())
  subscription_id       String
  subscription          CommercialSubscription @relation(fields: [subscription_id], references: [id])
  commercial_account_id String
  commercialAccount     CommercialAccount      @relation(fields: [commercial_account_id], references: [id])
  tenant_id             String
  environment_id        String
  scope                 String                 @default("[]")
  starts_at             DateTime
  ends_at               DateTime
  commercial_reason     String
  margin_impact         Decimal                @db.Decimal(8, 4)
  renewal_treatment     String
  status                String                 @default("PENDING_APPROVAL")
  approval_id           String?                @unique
  requested_by          String
  approved_by           String?
  approved_at           DateTime?
  activated_at          DateTime?
  expired_at            DateTime?
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt

  entitlements Entitlement[]

  @@index([subscription_id, status])
  @@index([commercial_account_id, status])
  @@index([tenant_id, environment_id, status])
  @@index([starts_at, status])
  @@index([ends_at, status])
}

model CommercialApproval {
  id                     String    @id @default(uuid())
  change_type            String
  object_type            String
  object_id              String
  tenant_id              String?
  requested_by           String
  requested_at           DateTime  @default(now())
  reason                 String
  before_snapshot        String    @default("{}")
  proposed_snapshot      String    @default("{}")
  financial_impact       Decimal?  @db.Decimal(14, 4)
  margin_impact          Decimal?  @db.Decimal(6, 4)
  required_approval_role String    @default("BILLING_ADMIN")
  status                 String    @default("PENDING_APPROVAL")
  approved_by            String?
  approved_at            DateTime?
  decision_reason        String?
  expires_at             DateTime?
  applied_at             DateTime?
  idempotency_key        String?   @unique

  legalRoadmapCommitment   RoadmapCommitment?   @relation("RoadmapLegalApproval")
  productRoadmapCommitment RoadmapCommitment?   @relation("RoadmapProductApproval")
  quoteDiscountReview      QuoteDiscountReview? @relation("QuoteDiscountApproval")

  @@index([object_type, object_id])
  @@index([tenant_id, status])
  @@index([status])
}

model IdempotencyRecord {
  id                  String    @id @default(uuid())
  idempotency_key     String
  operation           String
  tenant_id           String?
  actor_id            String?
  request_fingerprint String
  status              String    @default("IN_PROGRESS")
  response_code       Int?
  response_body       String?
  created_at          DateTime  @default(now())
  expires_at          DateTime?

  @@unique([idempotency_key, operation])
}

// ============================================================
// ZS-COM-BILL-001 P0.2: resource dedup / protected-resource coverage engine
// and telemetry metering engine (accepted != billable).
// ============================================================

model MeterDefinition {
  id                 String    @id @default(uuid())
  meter_key          String
  version            Int       @default(1)
  unit               String    @default("EVENTS")
  source_scope       String    @default("[]")
  validation_rules   String    @default("{}")
  aggregation_window String    @default("DAILY")
  dedupe_policy      String    @default("SOURCE_EVENT_ID")
  included_quantity  Int       @default(0)
  billable_policy    String    @default("STANDARD")
  correction_policy  String    @default("REVERSAL_REPLACEMENT_ADJUSTMENT")
  status             String    @default("DRAFT")
  effective_from     DateTime  @default(now())
  effective_to       DateTime?
  requested_by       String?
  approved_by        String?
  approved_at        DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  events                 MeterEvent[]
  usageRecords           UsageRecord[]
  authorizationPolicies  MeterAuthorizationPolicy[]
  coveragePolicies       ResourceCoveragePolicy[]
  bundleMeterProjections BundleMeterProjection[]

  @@unique([meter_key, version])
  @@index([status])
}

model MeterEvent {
  id                     String                    @id @default(uuid())
  tenant_id              String
  environment_id         String                    @default("UNBOUND")
  meter_definition_id    String
  meterDefinition        MeterDefinition           @relation(fields: [meter_definition_id], references: [id])
  meter_authorization_id String?
  meterAuthorization     MeterAuthorizationPolicy? @relation(fields: [meter_authorization_id], references: [id])
  usage_authorization_id String?
  usageAuthorization     MeterUsageAuthorization?  @relation(fields: [usage_authorization_id], references: [id])
  contract_id            String?
  source                 String
  source_event_id        String
  occurred_at            DateTime
  received_at            DateTime                  @default(now())
  quantity               Int                       @default(1)
  unit                   String                    @default("EVENTS")
  validation_state       String                    @default("UNVALIDATED")
  validation_reason      String?
  accepted_state         String                    @default("RECEIVED")
  billable_state         String                    @default("NON_BILLABLE")
  dedupe_state           String                    @default("UNIQUE")
  dedupe_key             String
  is_platform_generated  Boolean                   @default(false)
  correction_type        String                    @default("ORIGINAL")
  correction_of_event_id String?
  correctionOf           MeterEvent?               @relation("MeterEventCorrections", fields: [correction_of_event_id], references: [id])
  corrections            MeterEvent[]              @relation("MeterEventCorrections")
  event_metadata         String                    @default("{}")
  immutable_hash         String                    @default("")
  created_at             DateTime                  @default(now())

  @@index([tenant_id, meter_definition_id, dedupe_key])
  @@index([tenant_id, environment_id, occurred_at])
  @@index([meter_authorization_id, occurred_at])
  @@index([usage_authorization_id])
  @@index([correction_of_event_id])
  @@index([accepted_state])
  @@index([tenant_id])
}

/**
 * Contract-bound policy that may turn accepted evidence into billable usage.
 * An approved meter definition alone is intentionally insufficient.
 */
model MeterAuthorizationPolicy {
  id                           String            @id @default(uuid())
  tenant_id                    String
  environment_id               String
  commercial_account_id        String
  commercialAccount            CommercialAccount @relation(fields: [commercial_account_id], references: [id])
  contract_id                  String
  contract                     Contract          @relation(fields: [contract_id], references: [id])
  policy_key                   String
  version                      Int               @default(1)
  meter_definition_id          String
  meterDefinition              MeterDefinition   @relation(fields: [meter_definition_id], references: [id])
  price_book_id                String?
  authorized_source_scope      String            @default("[]")
  usage_type                   String            @default("STANDARD")
  billing_period               String            @default("MONTHLY")
  pricing_model                String            @default("USAGE")
  included_quantity            Int               @default(0)
  committed_quantity           Int?
  warning_thresholds           String            @default("[]")
  overage_behavior             String            @default("NO_OVERAGE")
  cap_quantity                 Int?
  overage_rate                 Decimal?          @db.Decimal(14, 6)
  criticality                  String            @default("CRITICAL_SECURITY")
  requires_usage_authorization Boolean           @default(false)
  visible_customer_policy      String            @default("{}")
  retention_policy             String            @default("{}")
  effective_from               DateTime          @default(now())
  effective_to                 DateTime?
  status                       String            @default("PENDING_APPROVAL")
  approval_id                  String?           @unique
  requested_by                 String
  approved_by                  String?
  approved_at                  DateTime?
  created_at                   DateTime          @default(now())
  updated_at                   DateTime          @updatedAt

  events                MeterEvent[]
  usageRecords          UsageRecord[]
  usageAuthorizations   MeterUsageAuthorization[]
  thresholdEvents       MeterThresholdEvent[]
  billingExports        MeterBillingExport[]
  invoiceBases          CommercialInvoiceLineBasis[]
  bundleMeterProjection BundleMeterProjection?       @relation("BundleMeterAuthorization")

  @@unique([tenant_id, environment_id, policy_key, version])
  @@index([tenant_id, environment_id, status])
  @@index([contract_id, status])
  @@index([meter_definition_id, status])
  @@index([effective_from, effective_to, status])
}

/**
 * Customer authorization for a disclosed egress/archive/overage operation.
 */
model MeterUsageAuthorization {
  id                     String                   @id @default(uuid())
  tenant_id              String
  environment_id         String
  meter_authorization_id String
  meterAuthorization     MeterAuthorizationPolicy @relation(fields: [meter_authorization_id], references: [id])
  authorization_type     String
  period_start           DateTime
  period_end             DateTime
  max_quantity           Int?
  reason                 String
  customer_reference     String?
  status                 String                   @default("PENDING_APPROVAL")
  approval_id            String?                  @unique
  requested_by           String
  approved_by            String?
  approved_at            DateTime?
  created_at             DateTime                 @default(now())
  updated_at             DateTime                 @updatedAt

  events       MeterEvent[]
  usageRecords UsageRecord[]

  @@index([tenant_id, environment_id, status])
  @@index([meter_authorization_id, status, period_start, period_end])
}

/**
 * Persisted, tenant-visible warning produced from current and forecast usage.
 */
model MeterThresholdEvent {
  id                     String                   @id @default(uuid())
  tenant_id              String
  environment_id         String
  meter_authorization_id String
  meterAuthorization     MeterAuthorizationPolicy @relation(fields: [meter_authorization_id], references: [id])
  period_start           DateTime
  period_end             DateTime
  threshold_percent      Int
  threshold_quantity     Int
  current_quantity       Int
  forecast_quantity      Float
  status                 String                   @default("OPEN")
  created_at             DateTime                 @default(now())

  @@unique([meter_authorization_id, period_start, threshold_percent])
  @@index([tenant_id, environment_id, status])
}

/**
 * Approved instruction for an append-only reversal, replacement or adjustment.
 */
model MeterCorrectionRequest {
  id                   String    @id @default(uuid())
  tenant_id            String
  environment_id       String
  original_event_id    String
  correction_type      String
  replacement_quantity Int?
  adjustment_quantity  Int?
  reason               String
  evidence_refs        String    @default("[]")
  status               String    @default("PENDING_APPROVAL")
  approval_id          String?   @unique
  requested_by         String
  approved_by          String?
  approved_at          DateTime?
  generated_event_ids  String    @default("[]")
  applied_at           DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  @@index([tenant_id, environment_id, status])
  @@index([original_event_id])
}

/**
 * Immutable billing input snapshot. Corrections create a superseding export.
 */
model MeterBillingExport {
  id                          String                   @id @default(uuid())
  tenant_id                   String
  environment_id              String
  meter_authorization_id      String
  meterAuthorization          MeterAuthorizationPolicy @relation(fields: [meter_authorization_id], references: [id])
  contract_id                 String
  period_start                DateTime
  period_end                  DateTime
  meter_definition_id         String
  meter_version               Int
  event_ids                   String                   @default("[]")
  usage_record_ids            String                   @default("[]")
  accepted_quantity           Int                      @default(0)
  billable_quantity           Int                      @default(0)
  overage_quantity            Int                      @default(0)
  billing_basis               String                   @default("ACCEPTED_DATA_USAGE")
  excluded_event_ids          String                   @default("[]")
  committed_capacity_included Boolean                  @default(false)
  immutable_snapshot          String
  checksum                    String
  status                      String                   @default("PENDING_APPROVAL")
  approval_id                 String?                  @unique
  reason                      String
  requested_by                String
  approved_by                 String?
  approved_at                 DateTime?
  supersedes_id               String?
  correction_request_id       String?
  created_at                  DateTime                 @default(now())

  invoiceBases CommercialInvoiceLineBasis[]

  @@index([tenant_id, environment_id, status])
  @@index([meter_authorization_id, period_start, period_end])
  @@index([contract_id, period_start, period_end])
  @@index([supersedes_id])
}

// ============================================================
// ZS-COM-BILL-001 P0.4 Part 18: dunning engine. Policy-driven, versioned,
// fail-closed — no hardcoded grace/restriction/suspension timings.
// Deliberately has zero knowledge of evidence/incidents/exports: payment
// failure must never be able to touch those domains from here.
// ============================================================

model DunningPolicy {
  id                   String    @id @default(uuid())
  policy_key           String
  version              Int       @default(1)
  grace_period_days    Int       @default(7)
  restrict_after_days  Int       @default(14)
  suspend_after_days   Int       @default(30)
  terminate_after_days Int       @default(60)
  status               String    @default("DRAFT")
  approved_by          String?
  approved_at          DateTime?
  created_at           DateTime  @default(now())

  @@unique([policy_key, version])
  @@index([status])
}

model DunningCase {
  id                String    @id @default(uuid())
  contract_id       String
  dunning_policy_id String
  status            String    @default("ACTIVE")
  triggered_at      DateTime  @default(now())
  last_action_at    DateTime  @default(now())
  resolved_at       DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@index([contract_id])
  @@index([status])
}

// ============================================================
// ZS-COM-BILL-001 P1 Part 13: SLA / service credit engine. SVC-04/FIN-04 —
// credits are evidence-linked, approved through the generic maker-checker
// engine, and posted only as an append-only credit note against an
// already-issued invoice. Never rewrites security/incident history.
// ============================================================

model SlaDefinition {
  id                  String    @id @default(uuid())
  sla_key             String
  version             Int       @default(1)
  metric              String
  /**
   * MIN: measured value must be >= target (e.g. uptime). MAX: measured value must be <= target (e.g. response time).
   */
  comparison          String    @default("MIN")
  target_value        Decimal   @db.Decimal(10, 4)
  service_tier        String    @default("STANDARD")
  region              String    @default("GLOBAL")
