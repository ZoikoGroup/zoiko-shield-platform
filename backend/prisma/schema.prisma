// ============================================================
// ZS-COM-BILL-001 P1 Part 12 / AI-01: internal AI cost != customer
// billable usage. Every AI action is logged with its true internal cost;
// it becomes customer-billable only through the same accepted-vs-billable
// MeteringService pipeline used everywhere else, gated on an explicit
// customer authorization (active AI_SECURITY entitlement).
// ============================================================

model AiUsageRecord {
  id             String   @id @default(uuid())
  tenant_id      String
  workflow       String
  provider       String
  model          String
  input_tokens   Int      @default(0)
  output_tokens  Int      @default(0)
  tool_calls     Int      @default(0)
  retrieval_calls Int     @default(0)
  internal_cost  Decimal  @default(0) @db.Decimal(14, 6)
  billable       Boolean  @default(false)
  meter_event_id String?
  occurred_at    DateTime @default(now())
  created_at     DateTime @default(now())

  @@index([tenant_id])
  @@index([occurred_at])
}

model AiBudget {
  id              String   @id @default(uuid())
  tenant_id       String
  period_start    DateTime
  period_end      DateTime
  budget_amount   Decimal  @db.Decimal(14, 4)
  consumed_amount Decimal  @default(0) @db.Decimal(14, 4)
  status          String   @default("ACTIVE")
  created_at      DateTime @default(now())

  @@index([tenant_id])
  @@index([status])
}

// ============================================================
// ZS-COM-BILL-001 P1 Part 26: internal unit economics. Never automatically
// exposed as customer price — used for margin analysis / approval gating.
// ============================================================

model CostRecord {
  id                String   @id @default(uuid())
  tenant_id         String?
  usage_class       String
  provider          String
  period_start      DateTime
  period_end        DateTime
  quantity          Decimal  @default(0) @db.Decimal(14, 4)
  unit_cost         Decimal  @default(0) @db.Decimal(14, 6)
