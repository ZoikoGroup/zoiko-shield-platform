{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/shield-core/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/shield-core/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/shield-core",
  "projects": {
    "shield-core": {
      "type": "application",
      "root": "apps/shield-core",
      "entryFile": "main",
      "sourceRoot": "apps/shield-core/src",
      "compilerOptions": {
        "tsConfigPath": "apps/shield-core/tsconfig.app.json"
      }
    },
    "shield-ingest": {
      "type": "application",
      "root": "apps/shield-ingest",
      "entryFile": "main",
      "sourceRoot": "apps/shield-ingest/src",
      "compilerOptions": {
        "tsConfigPath": "apps/shield-ingest/tsconfig.app.json"
      }
    },
    "shield-ai": {
      "type": "application",
      "root": "apps/shield-ai",
      "entryFile": "main",
      "sourceRoot": "apps/shield-ai/src",
      "compilerOptions": {
        "tsConfigPath": "apps/shield-ai/tsconfig.app.json"
      }
    },
    "shield-action": {
      "type": "application",
      "root": "apps/shield-action",
      "entryFile": "main",
      "sourceRoot": "apps/shield-action/src",
      "compilerOptions": {
        "tsConfigPath": "apps/shield-action/tsconfig.app.json"
      }
    },
    "shield-anchor": {
      "type": "application",
      "root": "apps/shield-anchor",
      "entryFile": "main",
      "sourceRoot": "apps/shield-anchor/src",
      "compilerOptions": {
        "tsConfigPath": "apps/shield-anchor/tsconfig.app.json"
      }
    },
    "verifier-cli": {
      "type": "application",
      "root": "apps/verifier-cli",
      "entryFile": "main",
      "sourceRoot": "apps/verifier-cli/src",
      "compilerOptions": {
        "tsConfigPath": "apps/verifier-cli/tsconfig.app.json"
      }
    }
  }
}