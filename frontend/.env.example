# ZoikoShield frontend environment.
# cp .env.example .env.local   (Next.js loads .env.local; it is git-ignored)
#
# These are read server-side only, by the /api/v1 proxy route
# (src/app/api/v1/[...slug]/route.ts). None are exposed to the browser.
# Values shown are the code's defaults — leave a line commented to keep it.

# Where the proxy forwards each request. Point these at container or remote
# hosts when the backend is not on this machine.
# SHIELD_CORE_URL=http://127.0.0.1:3001
# SHIELD_INGEST_URL=http://127.0.0.1:3002
# SHIELD_AI_URL=http://127.0.0.1:3003

# How long the proxy waits for the backend before reporting 502.
# BACKEND_PROXY_TIMEOUT_MS=15000

# Signs webhooks the proxy forwards to shield-ingest. Must equal
# WEBHOOK_HMAC_SECRET in the backend .env, or shield-ingest rejects every
# forwarded webhook. Required: the proxy refuses to forward a webhook it
# cannot sign rather than sending one shield-ingest will reject.
WEBHOOK_HMAC_SECRET=whsec_dev_local_secret_zoikoshield_2026

# Lets the browser client answer failed API calls with fabricated demo data
# instead of surfacing the error. Off by default: with it on, a 401 or a
# backend outage is indistinguishable in the UI from real data.
# NEXT_PUBLIC_DEMO_FALLBACK=false
